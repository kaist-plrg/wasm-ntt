;;
;; Runtime Values
;;

;; Default values

dec $default_value(valtype) : value?
def $default_value(NumT I32T) = NumV (I32 0)
def $default_value(NumT I64T) = NumV (I64 0)
def $default_value(NumT F32T) = NumV (F32 (POS (SUBNORM 0)))
def $default_value(NumT F64T) = NumV (F64 (POS (SUBNORM 0)))
def $default_value(VecT V128T) = VecV (V128 0)
def $default_value(RefT (Null ht)) = RefV (NullRef ht)
def $default_value(RefT (NoNull _)) = eps
def $default_value(BotT) = eps

;; Value typing

relation Num_ok: store |- num_ : numtype
  hint(input %0 %1)
relation Vec_ok: store |- vec_ : vectype
  hint(input %0 %1)
relation Ref_ok: store |- refval : reftype
  hint(input %0 %1)
relation Val_ok: store |- value : valtype
  hint(input %0 %1)

rule Num_ok/i32:
  STO |- I32 _ : I32T

rule Num_ok/i64:
  STO |- I64 _ : I64T

rule Num_ok/f32:
  STO |- F32 _ : F32T

rule Num_ok/f64:
  STO |- F64 _ : F64T

rule Vec_ok/v128:
  STO |- V128 _ : V128T

rule Ref_ok/null:
  STO |- NullRef ht : Null $bot_of_heap_type(ht)

rule Ref_ok/func:
  STO |- FuncRef a : NoNull (DefHT STO.FUNCS[a].TYPE)

rule Ref_ok/i31:
  STO |- I31Ref _ : NoNull I31HT

rule Ref_ok/struct:
  STO |- StructRef a : NoNull (DefHT STO.STRUCTS[a].TYPE)

rule Ref_ok/array:
  STO |- ArrayRef a : NoNull (DefHT STO.ARRAYS[a].TYPE)

rule Ref_ok/exn:
  STO |- ExnRef _ : NoNull ExnHT

rule Ref_ok/host:
  STO |- HostRef _ : NoNull AnyHT

rule Ref_ok/extern:
  STO |- ExternRef r : NoNull ExternHT

rule Val_ok/num:
  STO |- NumV num : NumT nt
  -- Num_ok: STO |- num : nt

rule Val_ok/vec:
  STO |- VecV vec : VecT vt
  -- Vec_ok: STO |- vec : vt

rule Val_ok/ref:
  STO |- RefV r : RefT rt
  -- Ref_ok: STO |- r : rt

;; External addresses

dec $match_externtype(deftype*, externtype, externtype) : bool

relation Externaddr_ok: store |- externaddr : externtype
  hint(input %0 %1)

rule Externaddr_ok/func:
  STO |- FuncAddr a : ExtFunct STO.FUNCS[a].TYPE

rule Externaddr_ok/global:
  STO |- GlobalAddr a : ExtGlobalT STO.GLOBALS[a].TYPE

rule Externaddr_ok/table:
  STO |- TableAddr a : ExtTableT STO.TABLES[a].TYPE

rule Externaddr_ok/mem:
  STO |- MemAddr a : ExtMemoryT STO.MEMS[a].TYPE

rule Externaddr_ok/tag:
  STO |- TagAddr a : ExtTagT STO.TAGS[a].TYPE
