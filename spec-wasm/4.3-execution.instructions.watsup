rule Step_plain_instr/test-generic:
  STO fr ((NumV num) :: v*) |- TEST top : (STO, fr, (NumV (I32 n)) :: v*, eps)
  -- if n = $eval_testop(top, num)

rule Step_plain_instr/compare-generic:
  STO fr ((NumV num_2) :: (NumV num_1) :: v*) |- COMPARE rop : (STO, fr, (NumV (I32 n)) :: v*, eps)
  -- if n = $eval_relop(rop, num_1, num_2)

rule Step_plain_instr/unop-generic:
