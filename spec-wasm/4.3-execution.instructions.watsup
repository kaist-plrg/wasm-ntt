rule Step_plain_instr/memory-grow-i64:
  STO fr ((NumV (I64 i64)) :: v*) |- MEMORY.GROW x : (STO', fr, (NumV (I64 pages)) :: v*, eps)
  -- if ma = fr.MODULE.MEMS[x]
