;;
;; Small-step Execution
;;

relation Step: config |- config
  hint(input %0)

relation Steps: config |- execoutcome
  hint(input %0)

relation Steps_until: config |- config
  hint(input %0)

relation Step_plain_instr:
  store frame value* |- instr : (store, frame, value*, admininstr*)
  hint(input %0 %1 %2 %3)

dec $plain_instrs(instr*) : admininstr*
def $plain_instrs(eps) = eps
def $plain_instrs(instr_1 :: instr*) =
  (Plain instr_1) :: $plain_instrs(instr*)

dec $apply_numresult(numresult, value*) : (value*, admininstr*)
def $apply_numresult(NumValue num, v*) =
  ((NumV num) :: v*, eps)
def $apply_numresult(NumTrap, v*) =
  (v*, (Trapping) :: eps)

;; Like eval.ml's `Plain e' -> match e'`, Step/plain delegates every Wasm
;; source instruction to Step_plain_instr.  Administrative instructions such
;; as Invoke, Label, Frame, and Handler remain direct Step transitions.

;; Steps_until is the reflexive-transitive Step closure up to an
;; administrative terminal state.  Contexts are evaluated structurally, but
;; every redex and every context return still uses the corresponding Step
;; rule; no instruction receives a separate big-step implementation.
rule Steps/values:
  cf |- ValuesO STO v*
  -- Steps_until: cf |- (STO, fr, v*, eps)

rule Steps/trap:
  cf |- TrapO STO
  -- Steps_until: cf |- (STO, fr, v*, (Trapping) :: adm*)

rule Steps/exception:
  cf |- ExceptionO STO ja v_throw*
  -- Steps_until:
      cf |- (STO, fr, v*, (Throwing ja v_throw*) :: adm*)

rule Steps_until/values:
  (STO, fr, v*, eps) |- (STO, fr, v*, eps)

rule Steps_until/break:
  (STO, fr, v*, (Breaking l v_break*) :: adm*) |-
    (STO, fr, v*, (Breaking l v_break*) :: adm*)

rule Steps_until/return:
  (STO, fr, v*, (Returning v_return*) :: adm*) |-
    (STO, fr, v*, (Returning v_return*) :: adm*)

rule Steps_until/return-invoke:
  (STO, fr, v*, (ReturningInvoke v_return* fa) :: adm*) |-
    (STO, fr, v*, (ReturningInvoke v_return* fa) :: adm*)

rule Steps_until/throw:
  (STO, fr, v*, (Throwing ja v_throw*) :: adm*) |-
    (STO, fr, v*, (Throwing ja v_throw*) :: adm*)

rule Steps_until/trap:
  (STO, fr, v*, (Trapping) :: adm*) |-
    (STO, fr, v*, (Trapping) :: adm*)

rule Steps_until/plain:
  (STO, fr, v*, (Plain instr) :: adm*) |- cf_final
  -- Step:
      (STO, fr, v*, (Plain instr) :: adm*) |- cf'
  -- Steps_until: cf' |- cf_final

rule Steps_until/refer:
  (STO, fr, v*, (Refer r) :: adm*) |- cf_final
  -- Step:
      (STO, fr, v*, (Refer r) :: adm*) |- cf'
  -- Steps_until: cf' |- cf_final

rule Steps_until/invoke:
  (STO, fr, v*, (Invoke fa) :: adm*) |- cf_final
  -- Step:
      (STO, fr, v*, (Invoke fa) :: adm*) |- cf'
  -- Steps_until: cf' |- cf_final

rule Steps_until/frame:
  (STO, fr, v*, (Frame n fr_inner v_inner* adm_inner*) :: adm*) |-
    cf_final
  -- Steps_until:
      (STO, fr_inner, v_inner*, adm_inner*) |-
        (STO_inner, fr_inner', v_inner'*, adm_inner'*)
  -- Step:
      (STO_inner, fr, v*,
        (Frame n fr_inner' v_inner'* adm_inner'*) :: adm*) |-
        cf'
  -- Steps_until: cf' |- cf_final

rule Steps_until/label:
  (STO, fr, v*, (Label n instr_0* v_inner* adm_inner*) :: adm*) |-
    cf_final
  -- Steps_until:
      (STO, fr, v_inner*, adm_inner*) |-
        (STO_inner, fr_inner', v_inner'*, adm_inner'*)
  -- Step:
      (STO_inner, fr_inner', v*,
        (Label n instr_0* v_inner'* adm_inner'*) :: adm*) |-
        cf'
  -- Steps_until: cf' |- cf_final

rule Steps_until/handler:
  (STO, fr, v*, (Handler n catch* v_inner* adm_inner*) :: adm*) |-
    cf_final
  -- Steps_until:
      (STO, fr, v_inner*, adm_inner*) |-
        (STO_inner, fr_inner', v_inner'*, adm_inner'*)
  -- Step:
      (STO_inner, fr_inner', v*,
        (Handler n catch* v_inner'* adm_inner'*) :: adm*) |-
        cf'
  -- Steps_until: cf' |- cf_final

rule Step/refer:
  (STO, fr, v*, (Refer r) :: adm*) |-
    (STO, fr, (RefV r) :: v*, adm*)

rule Step/plain:
  (STO, fr, v*, (Plain instr) :: adm*) |-
    (STO', fr', v'*, adm_all*)
  -- Step_plain_instr:
      STO fr v* |- instr : (STO', fr', v'*, adm_emit*)
  -- if adm_all* = adm_emit* ++ adm*

;;
;; Administrative Frame contexts
;;

rule Step/frame-step:
  (STO, fr, v*, (Frame n fr_inner v_inner* adm_inner*) :: adm*) |-
  (STO', fr, v*, (Frame n fr_inner' v_inner'* adm_inner'*) :: adm*)
  -- Step: (STO, fr_inner, v_inner*, adm_inner*) |-
      (STO', fr_inner', v_inner'*, adm_inner'*)

rule Step/frame-values:
  (STO, fr, v*, (Frame n fr_inner v_inner* eps) :: adm*) |-
    (STO, fr, v_all*, adm*)
  -- if v_all* = v_inner* ++ v*

rule Step/frame-return:
  (STO, fr, v*, (Frame n fr_inner v_inner*
    ((Returning v_return*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v_all*, adm*)
  -- if v_result* = $take_<value>(v_return*, n)
  -- if v_all* = v_result* ++ v*

rule Step/frame-return-invoke:
  (STO, fr, v*, (Frame n fr_inner v_inner*
    ((ReturningInvoke v_return* fa) :: adm_inner*)) :: adm*) |-
    (STO, fr, v_all*, (Invoke fa) :: adm*)
  -- if fi = STO.FUNCS[fa]
  -- if DefFuncT (FuncT t_arg* t_result*) = $expanddt(fi.TYPE)
  -- if v_arg* = $take_<value>(v_return*, |t_arg*|)
  -- if v_all* = v_arg* ++ v*

rule Step/frame-break:
  (STO, fr, v*, (Frame n fr_inner v_inner*
    ((Breaking l v_break*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Breaking l v_break*) :: adm*)

rule Step/frame-throw:
  (STO, fr, v*, (Frame n fr_inner v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Throwing ja v_throw*) :: adm*)

rule Step/frame-trap:
  (STO, fr, v*, (Frame n fr_inner v_inner*
    ((Trapping) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Trapping) :: adm*)

;;
;; Administrative Label contexts
;;

rule Step/label-step:
  (STO, fr, v*, (Label n instr_0* v_inner* adm_inner*) :: adm*) |-
    (STO', fr', v*, (Label n instr_0* v_inner'* adm_inner'*) :: adm*)
  -- Step: (STO, fr, v_inner*, adm_inner*) |-
      (STO', fr', v_inner'*, adm_inner'*)

rule Step/label-values:
  (STO, fr, v*, (Label n instr_0* v_inner* eps) :: adm*) |-
    (STO, fr, v_all*, adm*)
  -- if v_all* = v_inner* ++ v*

rule Step/label-break-zero:
  (STO, fr, v*, (Label n instr_0* v_inner* ((Breaking 0 v_break*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v_all*, adm_all*)
  -- if v_take* = $take_<value>(v_break*, n)
  -- if v_all* = v_take* ++ v*
  -- if adm_all* = $plain_instrs(instr_0*) ++ adm*

rule Step/label-break-succ:
  (STO, fr, v*, (Label n instr_0* v_inner* ((Breaking l v_break*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Breaking l' v_break*) :: adm*)
  -- if $(l > 0)
  -- if l' = $(l - 1)

rule Step/label-return:
  (STO, fr, v*, (Label n instr_0* v_inner*
    ((Returning v_return*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Returning v_return*) :: adm*)

rule Step/label-return-invoke:
  (STO, fr, v*, (Label n instr_0* v_inner*
    ((ReturningInvoke v_return* fa) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (ReturningInvoke v_return* fa) :: adm*)

rule Step/label-throw:
  (STO, fr, v*, (Label n instr_0* v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Throwing ja v_throw*) :: adm*)

rule Step/label-trap:
  (STO, fr, v*, (Label n instr_0* v_inner*
    ((Trapping) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Trapping) :: adm*)

;;
;; Public constant-expression and invocation compatibility boundaries
;;

;; Note: evaluation of const expressions does not affect the store

relation Eval_const: store moduleinst |- const : (store, value)
  hint(input %0 %1 %2)

relation Eval_consts: store moduleinst |- const* : (store, value*)
  hint(input %0 %1 %2)

relation Invoke: store funcaddr value* |- execoutcome
  hint(input %0 %1 %2)

relation Invoke_ok: store funcaddr value* |- value* : store
  hint(input %0 %1 %2)

rule Eval_const/exec:
  STO moduleinst |- const : (STO', v)
  -- if fr_const = { LOCALS eps, MODULE moduleinst }
  -- if adm_const* = $plain_instrs(const)
  -- Steps:
      (STO, fr_const, eps, adm_const*) |-
        ValuesO STO' (v :: eps)

rule Eval_consts/cons:
  STO moduleinst |- const_1 :: const* : (STO_2, v_1 :: v*)
  -- Eval_const: STO moduleinst |- const_1 : (STO_1, v_1)
  -- Eval_consts: STO_1 moduleinst |- const* : (STO_2, v*)

rule Eval_consts/nil:
  STO moduleinst |- eps : (STO, eps)

dec $refs_of_values(value*) : refval*
def $refs_of_values(eps) = eps
def $refs_of_values((RefV r) :: v*) = r :: $refs_of_values(v*)

dec $pack_field(storagetype, value) : fieldval
dec $pack_fields(fieldtype*, value*) : fieldval*
dec $unpack_field(fieldval) : value
dec $unpack_field_ext(fieldval, extension) : value
dec $some_values(value*) : (value?)*
dec $default_locals(moduleinst, local*) : (value?)*
dec $default_field_values(fieldtype*) : value*
dec $storage_size_nat(storagetype) : nat
dec $fieldval_of_storage_bytes(storagetype, byte*) : fieldval
dec $fieldvals_of_data(storagetype, byte*, nat, nat) : fieldval*
dec $fieldvals_of_refs(storagetype, refval*) : fieldval*
dec $ref_eq(refval, refval) : nat

def $pack_field(ValStorageT _, v) = FieldValue v
def $pack_field(PackStorageT I8, NumV (I32 n)) = PackedField I8 $byte_of_i32(n)
def $pack_field(PackStorageT I16, NumV (I32 n)) = PackedField I16 $i32_of_bytes($bytes_of_i32(n)[0:2])

def $unpack_field(FieldValue v) = v
def $unpack_field(PackedField pt n) = NumV (I32 n)

def $unpack_field_ext(FieldValue v, extension) = v
def $unpack_field_ext(PackedField I8 n, ZX) = NumV (I32 n)
def $unpack_field_ext(PackedField I16 n, ZX) = NumV (I32 n)
def $unpack_field_ext(PackedField I8 n, SX) = NumV (I32 $i32_extend_i8_s(n))
def $unpack_field_ext(PackedField I16 n, SX) = NumV (I32 $i32_extend_i16_s(n))

def $pack_fields(eps, eps) = eps
def $pack_fields((FieldT mut zt) :: yt*, v_1 :: v*) =
  $pack_field(zt, v_1) :: $pack_fields(yt*, v*)

def $some_values(eps) = eps
def $some_values(v_1 :: v*) = v_1 :: $some_values(v*)

def $default_locals(moduleinst, eps) = eps
def $default_locals(moduleinst, { LTYPE t } :: local*) =
  $default_value($inst_valtype(moduleinst, t)) :: $default_locals(moduleinst, local*)

def $default_field_values(eps) = eps
def $default_field_values((FieldT mut zt) :: yt*) =
  v_1 :: $default_field_values(yt*)
  -- if v_1 = $default_value($unpacked_storage_type(zt))

def $storage_size_nat(PackStorageT I8) = 1
def $storage_size_nat(PackStorageT I16) = 2
def $storage_size_nat(PackStorageT I32) = 4
def $storage_size_nat(PackStorageT I64) = 8
def $storage_size_nat(ValStorageT (NumT I32T)) = 4
def $storage_size_nat(ValStorageT (NumT I64T)) = 8
def $storage_size_nat(ValStorageT (NumT F32T)) = 4
def $storage_size_nat(ValStorageT (NumT F64T)) = 8
def $storage_size_nat(ValStorageT (VecT V128T)) = 16

def $fieldval_of_storage_bytes(PackStorageT I8, b*) = PackedField I8 b*[0]
def $fieldval_of_storage_bytes(PackStorageT I16, b*) = PackedField I16 $i32_of_bytes(b*)
def $fieldval_of_storage_bytes(ValStorageT (NumT I32T), b*) =
  FieldValue (NumV (I32 $i32_of_bytes(b*)))
def $fieldval_of_storage_bytes(ValStorageT (NumT I64T), b*) =
  FieldValue (NumV (I64 $i64_of_bytes(b*)))
def $fieldval_of_storage_bytes(ValStorageT (NumT F32T), b*) =
  FieldValue (NumV (F32 $f32_of_bytes(b*)))
def $fieldval_of_storage_bytes(ValStorageT (NumT F64T), b*) =
  FieldValue (NumV (F64 $f64_of_bytes(b*)))
def $fieldval_of_storage_bytes(ValStorageT (VecT V128T), b*) =
  FieldValue (VecV (V128 $v128_of_bytes(b*)))

def $fieldvals_of_data(zt, b*, offset, n) = eps
  -- if n = 0
def $fieldvals_of_data(zt, b*, offset, n) =
  fv :: $fieldvals_of_data(zt, b*, offset', n')
  -- if $(n > 0)
  -- if nsize = $storage_size_nat(zt)
  -- if fv = $fieldval_of_storage_bytes(zt, b*[offset:nsize])
  -- if offset' = $(offset + nsize)
  -- if n' = $(n - 1)

def $fieldvals_of_refs(zt, eps) = eps
def $fieldvals_of_refs(zt, r_1 :: r_t*) =
  $pack_field(zt, RefV r_1) :: $fieldvals_of_refs(zt, r_t*)

def $ref_eq(NullRef _, NullRef _) = 1
def $ref_eq(r, r) = 1
def $ref_eq(r_1, r_2) = 0
  -- otherwise

dec $block_result_arity(moduleinst, blocktype) : nat
dec $block_param_arity(moduleinst, blocktype) : nat
dec $block_input_stack(value*, nat) : value*
dec $block_outer_stack(value*, nat) : value*

def $block_result_arity(moduleinst, ValBlockType eps) = 0
def $block_result_arity(moduleinst, ValBlockType t) = 1
def $block_result_arity(moduleinst, VarBlockType x) = |t_2*|
  -- if DefFuncT (FuncT t_1* t_2*) = $expanddt(moduleinst.TYPES[x])

def $block_param_arity(moduleinst, ValBlockType eps) = 0
def $block_param_arity(moduleinst, ValBlockType t) = 0
def $block_param_arity(moduleinst, VarBlockType x) = |t_1*|
  -- if DefFuncT (FuncT t_1* t_2*) = $expanddt(moduleinst.TYPES[x])

def $block_input_stack(v*, n) = $take_<value>(v*, n)
def $block_outer_stack(v*, n) = v_rest*
  -- if nrest = $(|v*| - n)
  -- if v_rest* = v*[n:nrest]

;;
;; Plain source control instructions
;;

rule Step_plain_instr/unreachable:
  STO fr v* |- UNREACHABLE : (STO, fr, v*, (Trapping) :: eps)

rule Step_plain_instr/block:
  STO fr v* |- (BLOCK blocktype instr*) :
    (STO, fr, v_rest*, (Label nresult eps v_arg* adm_body*) :: eps)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if nresult = $block_result_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- if adm_body* = $plain_instrs(instr*)

rule Step_plain_instr/loop:
  STO fr v* |- (LOOP blocktype instr*) :
    (STO, fr, v_rest*,
      (Label nparam ((LOOP blocktype instr*) :: eps) v_arg* adm_body*) :: eps)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- if adm_body* = $plain_instrs(instr*)

rule Step_plain_instr/cond-true:
  STO fr ((NumV (I32 i)) :: v*) |-
    (IF blocktype instr_1* ELSE instr_2*) :
      (STO, fr, v*, (Plain (BLOCK blocktype instr_1*)) :: eps)
  -- if $(i =/= 0)

rule Step_plain_instr/cond-false:
  STO fr ((NumV (I32 0)) :: v*) |-
    (IF blocktype instr_1* ELSE instr_2*) :
      (STO, fr, v*, (Plain (BLOCK blocktype instr_2*)) :: eps)

rule Step_plain_instr/br:
  STO fr v* |- (BR l) : (STO, fr, eps, (Breaking l v*) :: eps)

rule Step_plain_instr/brif-true:
  STO fr ((NumV (I32 i)) :: v*) |- (BR_IF l) :
    (STO, fr, v*, (Plain (BR l)) :: eps)
  -- if $(i =/= 0)

rule Step_plain_instr/brif-false:
  STO fr ((NumV (I32 0)) :: v*) |- (BR_IF l) : (STO, fr, v*, eps)

rule Step_plain_instr/br-table-in:
  STO fr ((NumV (I32 i)) :: v*) |- (BR_TABLE l* x) :
    (STO, fr, v*, (Plain (BR y)) :: eps)
  -- if $(i < |l*|)
  -- if y = l*[i]

rule Step_plain_instr/br-table-out:
  STO fr ((NumV (I32 i)) :: v*) |- (BR_TABLE l* x) :
    (STO, fr, v*, (Plain (BR x)) :: eps)
  -- if $(i >= |l*|)

rule Step_plain_instr/br-on-null-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- (BR_ON_NULL l) :
    (STO, fr, v*, (Plain (BR l)) :: eps)

rule Step_plain_instr/br-on-null-non-null:
  STO fr ((RefV r) :: v*) |- (BR_ON_NULL l) :
    (STO, fr, (RefV r) :: v*, eps)
  -- Ref_ok: STO |- r : NoNull ht

rule Step_plain_instr/br-on-non-null-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- (BR_ON_NON_NULL l) :
    (STO, fr, v*, eps)

rule Step_plain_instr/br-on-non-null-non-null:
  STO fr ((RefV r) :: v*) |- (BR_ON_NON_NULL l) :
    (STO, fr, (RefV r) :: v*, (Plain (BR l)) :: eps)
  -- Ref_ok: STO |- r : NoNull ht

rule Step_plain_instr/br-on-cast-true:
  STO fr ((RefV r) :: v*) |- (BR_ON_CAST l rt_1 rt_2) :
    (STO, fr, (RefV r) :: v*, (Plain (BR l)) :: eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if $match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/br-on-cast-false:
  STO fr ((RefV r) :: v*) |- (BR_ON_CAST l rt_1 rt_2) :
    (STO, fr, (RefV r) :: v*, eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if ~$match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/br-on-cast-fail-true:
  STO fr ((RefV r) :: v*) |- (BR_ON_CAST_FAIL l rt_1 rt_2) :
    (STO, fr, (RefV r) :: v*, eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if $match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/br-on-cast-fail-false:
  STO fr ((RefV r) :: v*) |- (BR_ON_CAST_FAIL l rt_1 rt_2) :
    (STO, fr, (RefV r) :: v*, (Plain (BR l)) :: eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if ~$match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/return:
  STO fr v* |- RETURN : (STO, fr, eps, (Returning v*) :: eps)

;;
;; Plain source calls and tail calls
;;

rule Step_plain_instr/call:
  STO fr v* |- (CALL x) : (STO, fr, v*, (Invoke fa) :: eps)
  -- if fa = fr.MODULE.FUNCS[x]

rule Step_plain_instr/call-ref-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- (CALL_REF x) :
    (STO, fr, v*, (Trapping) :: eps)

rule Step_plain_instr/call-ref:
  STO fr ((RefV (FuncRef fa)) :: v*) |- (CALL_REF x) :
    (STO, fr, v*, (Invoke fa) :: eps)

rule Step_plain_instr/call-indirect-bounds:
  STO fr ((NumV num_i) :: v*) |- (CALL_INDIRECT x y) :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i >= |STO.TABLES[ta].REFS|)

rule Step_plain_instr/call-indirect-null:
  STO fr ((NumV num_i) :: v*) |- (CALL_INDIRECT x y) :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if NullRef ht = STO.TABLES[ta].REFS[i]

rule Step_plain_instr/call-indirect-mismatch:
  STO fr ((NumV num_i) :: v*) |- (CALL_INDIRECT x y) :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if FuncRef fa = STO.TABLES[ta].REFS[i]
  -- if fi = STO.FUNCS[fa]
  -- if ~$match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])

rule Step_plain_instr/call-indirect:
  STO fr ((NumV num_i) :: v*) |- (CALL_INDIRECT x y) :
    (STO, fr, v*, (Invoke fa) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if FuncRef fa = STO.TABLES[ta].REFS[i]
  -- if fi = STO.FUNCS[fa]
  -- if $match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])

rule Step_plain_instr/return-call:
  STO fr v* |- (RETURN_CALL x) :
    (STO, fr, eps, (ReturningInvoke v* fa) :: eps)
  -- if fa = fr.MODULE.FUNCS[x]

rule Step_plain_instr/return-call-ref-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- (RETURN_CALL_REF x) :
    (STO, fr, v*, (Trapping) :: eps)

rule Step_plain_instr/return-call-ref:
  STO fr ((RefV (FuncRef fa)) :: v*) |- (RETURN_CALL_REF x) :
    (STO, fr, eps, (ReturningInvoke v* fa) :: eps)

rule Step_plain_instr/return-call-indirect-bounds:
  STO fr ((NumV num_i) :: v*) |- (RETURN_CALL_INDIRECT x y) :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i >= |STO.TABLES[ta].REFS|)

rule Step_plain_instr/return-call-indirect-null:
  STO fr ((NumV num_i) :: v*) |- (RETURN_CALL_INDIRECT x y) :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if NullRef ht = STO.TABLES[ta].REFS[i]

rule Step_plain_instr/return-call-indirect-mismatch:
  STO fr ((NumV num_i) :: v*) |- (RETURN_CALL_INDIRECT x y) :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if FuncRef fa = STO.TABLES[ta].REFS[i]
  -- if fi = STO.FUNCS[fa]
  -- if ~$match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])

rule Step_plain_instr/return-call-indirect:
  STO fr ((NumV num_i) :: v*) |- (RETURN_CALL_INDIRECT x y) :
    (STO, fr, eps, (ReturningInvoke v* fa) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if FuncRef fa = STO.TABLES[ta].REFS[i]
  -- if fi = STO.FUNCS[fa]
  -- if $match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])

rule Step/invoke-ast:
  (STO, fr, v*, (Invoke fa) :: adm*) |-
    (STO, fr, v_rest*,
      (Frame m fr_callee eps
        ((Label m eps eps adm_body*) :: eps)) :: adm*)
  -- if fi = STO.FUNCS[fa]
  -- if AstFunc func = fi.CODE
  -- if DefFuncT (FuncT t_arg* t_result*) = $expanddt(fi.TYPE)
  -- if n = |t_arg*|
  -- if m = |t_result*|
  -- if v_arg_stack* = $take_<value>(v*, n)
  -- if v_arg* = $rev_<value>(v_arg_stack*)
  -- if v_rest* = $block_outer_stack(v*, n)
  -- if fr_callee = {
      LOCALS ($some_values(v_arg*) ++ $default_locals(fi.MODULE, func.LOCALS)),
      MODULE fi.MODULE
    }
  -- if adm_body* = $plain_instrs(func.BODY)

rule Step/invoke-host-no-result:
  (STO, fr, v*, (Invoke fa) :: adm*) |-
    (STO, fr, v_rest*, adm*)
  -- if fi = STO.FUNCS[fa]
  -- if HostFunc _ = fi.CODE
  -- if DefFuncT (FuncT t_arg* eps) = $expanddt(fi.TYPE)
  -- if $(|t_arg*| <= |v*|)
  -- if v_rest* = $block_outer_stack(v*, |t_arg*|)

;;
;; Plain source exceptions
;;

rule Step_plain_instr/throw:
  STO fr v* |- (THROW x) :
    (STO, fr, v_rest*, (Throwing ja v_throw*) :: eps)
  -- if ja = fr.MODULE.TAGS[x]
  -- if TagT dtf = STO.TAGS[ja].TYPE
  -- if DefFuncT (FuncT t_arg* eps) = $expanddt(dtf)
  -- if n = |t_arg*|
  -- if v_throw* = $take_<value>(v*, n)
  -- if v_rest* = $block_outer_stack(v*, n)

rule Step_plain_instr/throw-ref-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- THROW_REF :
    (STO, fr, v*, (Trapping) :: eps)

rule Step_plain_instr/throw-ref:
  STO fr ((RefV (ExnRef a)) :: v*) |- THROW_REF :
    (STO, fr, v*, (Throwing ja v_throw*) :: eps)
  -- if ja = STO.EXNS[a].TAG
  -- if v_throw* = STO.EXNS[a].FIELDS

rule Step_plain_instr/try-table:
  STO fr v* |- (TRY_TABLE blocktype catch* instr*) :
    (STO, fr, v_rest*,
      (Handler nresult catch* eps
        ((Label nresult eps v_arg* adm_body*) :: eps)) :: eps)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if nresult = $block_result_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- if adm_body* = $plain_instrs(instr*)

;;
;; Administrative exception handlers
;;

rule Step/handler-values:
  (STO, fr, v*, (Handler n catch* v_inner* eps) :: adm*) |-
    (STO, fr, v_all*, adm*)
  -- if v_all* = v_inner* ++ v*

rule Step/handler-catch:
  (STO, fr, v*, (Handler n ((Catch x y) :: catch*) v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v_all*, (Plain (BR y)) :: adm*)
  -- if ja = fr.MODULE.TAGS[x]
  -- if v_all* = v_throw* ++ v*

rule Step/handler-catch-skip:
  (STO, fr, v*, (Handler n ((Catch x y) :: catch*) v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*,
      (Handler n catch* v_inner*
        ((Throwing ja v_throw*) :: adm_inner*)) :: adm*)
  -- if ~(ja = fr.MODULE.TAGS[x])

rule Step/handler-catch-ref:
  (STO, fr, v*, (Handler n ((CatchRef x y) :: catch*) v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO', fr, (RefV (ExnRef a)) :: v_all*, (Plain (BR y)) :: adm*)
  -- if ja = fr.MODULE.TAGS[x]
  -- if a = |STO.EXNS|
  -- if STO' = STO[ .EXNS = STO.EXNS ++ [{ TAG ja, FIELDS v_throw* }] ]
  -- if v_all* = v_throw* ++ v*

rule Step/handler-catch-ref-skip:
  (STO, fr, v*, (Handler n ((CatchRef x y) :: catch*) v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*,
      (Handler n catch* v_inner*
        ((Throwing ja v_throw*) :: adm_inner*)) :: adm*)
  -- if ~(ja = fr.MODULE.TAGS[x])

rule Step/handler-catch-all:
  (STO, fr, v*, (Handler n ((CatchAll x) :: catch*) v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Plain (BR x)) :: adm*)

rule Step/handler-catch-all-ref:
  (STO, fr, v*, (Handler n ((CatchAllRef x) :: catch*) v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO', fr, (RefV (ExnRef a)) :: v*, (Plain (BR x)) :: adm*)
  -- if a = |STO.EXNS|
  -- if STO' = STO[ .EXNS = STO.EXNS ++ [{ TAG ja, FIELDS v_throw* }] ]

rule Step/handler-rethrow:
  (STO, fr, v*, (Handler n eps v_inner*
    ((Throwing ja v_throw*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Throwing ja v_throw*) :: adm*)

rule Step/handler-break:
  (STO, fr, v*, (Handler n catch* v_inner*
    ((Breaking l v_break*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Breaking l v_break*) :: adm*)

rule Step/handler-return:
  (STO, fr, v*, (Handler n catch* v_inner*
    ((Returning v_return*) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Returning v_return*) :: adm*)

rule Step/handler-return-invoke:
  (STO, fr, v*, (Handler n catch* v_inner*
    ((ReturningInvoke v_return* fa) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (ReturningInvoke v_return* fa) :: adm*)

rule Step/handler-trap:
  (STO, fr, v*, (Handler n catch* v_inner*
    ((Trapping) :: adm_inner*)) :: adm*) |-
    (STO, fr, v*, (Trapping) :: adm*)

rule Step/handler-step:
  (STO, fr, v*, (Handler n catch* v_inner* adm_inner*) :: adm*) |-
    (STO', fr', v*, (Handler n catch* v_inner'* adm_inner'*) :: adm*)
  -- Step: (STO, fr, v_inner*, adm_inner*) |-
      (STO', fr', v_inner'*, adm_inner'*)

rule Invoke:
  STO fa v_arg* |- eo
  -- if v_stack* = $rev_<value>(v_arg*)
  -- if fr_init = { LOCALS eps, MODULE $empty_moduleinst }
  -- Steps:
      (STO, fr_init, v_stack*, (Invoke fa) :: eps) |-
        eo

rule Invoke_ok:
  STO fa v_arg* |- v_result* : STO'
  -- if fi = STO.FUNCS[fa]
  -- if DefFuncT (FuncT t_arg* t_result*) = $expanddt(fi.TYPE)
  -- if |v_arg*| = |t_arg*|
  -- (Val_ok: STO |- v_arg : t_actual)*
  -- (if $match_valtype(eps, t_actual, t_arg))*
  -- Invoke: STO fa v_arg* |- ValuesO STO' v_stack_result*
  -- if v_result* = $rev_<value>(v_stack_result*)

rule Step_plain_instr/local-get:
  STO fr v* |- LOCAL.GET x : (STO, fr, v_1 :: v*, eps)
  -- if v_1 = fr.LOCALS[x]

rule Step_plain_instr/local-set:
  STO fr (v_1 :: v*) |- LOCAL.SET x : (STO, fr', v*, eps)
  -- if fr' = fr[ .LOCALS[x] = v_1 ]

rule Step_plain_instr/local-tee:
  STO fr (v_1 :: v*) |- LOCAL.TEE x : (STO, fr', v_1 :: v*, eps)
  -- if fr' = fr[ .LOCALS[x] = v_1 ]

rule Step_plain_instr/global-set:
  STO fr (v_1 :: v*) |- GLOBAL.SET x : (STO', fr, v*, eps)
  -- if ga = fr.MODULE.GLOBALS[x]
  -- if STO' = STO[ .GLOBALS[ga].VALUE = v_1 ]

rule Step_plain_instr/memory-size-i32:
  STO fr v* |- MEMORY.SIZE x : (STO, fr, (NumV (I32 pages)) :: v*, eps)
  -- if ma = fr.MODULE.MEMS[x]
  -- if MemoryT I32AT lim = STO.MEMS[ma].TYPE
  -- if pages = $(|STO.MEMS[ma].BYTES| / $page_size)

rule Step_plain_instr/memory-size-i64:
  STO fr v* |- MEMORY.SIZE x : (STO, fr, (NumV (I64 pages)) :: v*, eps)
  -- if ma = fr.MODULE.MEMS[x]
  -- if MemoryT I64AT lim = STO.MEMS[ma].TYPE
  -- if pages = $(|STO.MEMS[ma].BYTES| / $page_size)

rule Step_plain_instr/memory-grow-i32:
  STO fr ((NumV (I32 n)) :: v*) |- MEMORY.GROW x : (STO', fr, (NumV (I32 pages)) :: v*, eps)
  -- if ma = fr.MODULE.MEMS[x]
  -- if MemoryT I32AT { MIN u64, MAX eps } = STO.MEMS[ma].TYPE
  -- if pages = $(|STO.MEMS[ma].BYTES| / $page_size)
