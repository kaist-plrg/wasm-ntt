      LOCALS ($some_values(v_arg*) ++ $default_locals(fi.MODULE, func.LOCALS)),
      MODULE fi.MODULE
    }
  -- Exec_instrs_ctrl: s fr eps |- func.BODY : ThrowR s' frp ja v_throw*

rule Invoke_funcaddr/host-no-result:
  s v* |- fa : (s, v_rest*)
  -- if fi = s.FUNCS[fa]
  -- if HostFunc _ = fi.CODE
  -- if DefFuncT (FuncT t_arg* eps) = $expanddt(fi.TYPE)
  -- if $(|t_arg*| <= |v*|)
  -- if n = $(|v*| - |t_arg*|)
  -- if v_rest* = v*[|t_arg*|:n]

rule Invoke_ok:
  s fa v_arg* |- v_result* : s'
  -- if v_stack* = $rev_<value>(v_arg*)
  -- Invoke_funcaddr: s v_stack* |- fa : (s', v_stack_result*)
  -- if v_result* = $rev_<value>(v_stack_result*)

rule Exec_instr_frame/base:
  s fr v* |- instr : (s', fr, v'*)
  -- Exec_instr: s fr.MODULE v* |- instr : (s', v'*)

rule Exec_instr_frame/local-get:
  s fr v* |- LOCAL.GET x : (s, fr, v_1 :: v*)
  -- if v_1 = fr.LOCALS[x]

rule Exec_instr_frame/local-set:
  s fr (v_1 :: v*) |- LOCAL.SET x : (s, fr', v*)
  -- if fr' = fr[ .LOCALS[x] = v_1 ]

rule Exec_instr_frame/local-tee:
  s fr (v_1 :: v*) |- LOCAL.TEE x : (s, fr', v_1 :: v*)
  -- if fr' = fr[ .LOCALS[x] = v_1 ]

rule Exec_instr_frame/global-set:
  s fr (v_1 :: v*) |- GLOBAL.SET x : (s', fr, v*)
  -- if ga = fr.MODULE.GLOBALS[x]
  -- if s' = s[ .GLOBALS[ga].VALUE = v_1 ]

rule Exec_instr_frame/memory-size-i32:
  s fr v* |- MEMORY.SIZE x : (s, fr, (NumV (I32 pages)) :: v*)
  -- if ma = fr.MODULE.MEMS[x]
  -- if MemoryT I32AT lim = s.MEMS[ma].TYPE
  -- if pages = $(|s.MEMS[ma].BYTES| / $page_size)

rule Exec_instr_frame/memory-size-i64:
  s fr v* |- MEMORY.SIZE x : (s, fr, (NumV (I64 pages)) :: v*)
  -- if ma = fr.MODULE.MEMS[x]
  -- if MemoryT I64AT lim = s.MEMS[ma].TYPE
  -- if pages = $(|s.MEMS[ma].BYTES| / $page_size)

rule Exec_instr_frame/memory-grow-i32:
  s fr ((NumV (I32 n)) :: v*) |- MEMORY.GROW x : (s', fr, (NumV (I32 pages)) :: v*)
  -- if ma = fr.MODULE.MEMS[x]
  -- if MemoryT I32AT { MIN i64, MAX eps } = s.MEMS[ma].TYPE
  -- if pages = $(|s.MEMS[ma].BYTES| / $page_size)
