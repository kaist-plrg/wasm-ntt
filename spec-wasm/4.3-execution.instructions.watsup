  -- if $(i =/= j)

rule Step_plain_instr/compare-i32-ne:
  STO fr ((NumV (I32 j)) :: (NumV (I32 i)) :: v*) |- COMPARE (I32 Ne) : (STO, fr, (NumV (I32 n)) :: v*, eps)
