rule Exec_instr/table-grow-i32-unbounded-fail:
  s mm ((NumV (I32 n)) :: (RefV r) :: v*) |- TABLE.GROW x : (s, (NumV (I32 4294967295)) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I32AT { MIN i64, MAX eps } rt = s.TABLES[ta].TYPE
  -- if old = |s.TABLES[ta].REFS|
  -- if newsize = $(old + n)
  -- if $(newsize > 4294967295)

rule Exec_instr/table-grow-i32-bounded:
  s mm ((NumV (I32 n)) :: (RefV r) :: v*) |- TABLE.GROW x : (s', (NumV (I32 old)) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I32AT { MIN i64, MAX i64_1 } rt = s.TABLES[ta].TYPE
