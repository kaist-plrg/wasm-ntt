  -- Exec_instrs_ctrl: s fr eps |- func.BODY : ReturnR s' frp v_result_stack*
  -- if m = |t_result*|
  -- if v_results* = $take_<value>(v_result_stack*, m)
  -- if v'* = v_results* ++ v_rest*

rule Invoke_funcaddr/ast-break-zero:
  s v* |- fa : (s', v'*)
  -- if fi = s.FUNCS[fa]
  -- if AstFunc func = fi.CODE
