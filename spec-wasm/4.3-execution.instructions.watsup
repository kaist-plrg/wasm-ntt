rule Exec_instr/nop:
  s mm v* |- NOP : (s, v*)

rule Exec_instr/drop:
  s mm (v_1 :: v*) |- DROP : (s, v*)

rule Exec_instr/select-true:
  s mm ((NumV (I32 i)) :: v_2 :: v_1 :: v*) |- SELECT t*? : (s, v_1 :: v*)
  -- if $(i =/= 0)

rule Exec_instr/select-false:
  s mm ((NumV (I32 i)) :: v_2 :: v_1 :: v*) |- SELECT t*? : (s, v_2 :: v*)
  -- if i = 0

rule Exec_instr/const:
  s mm v* |- CONST num : (s, (NumV num) :: v*)

rule Exec_instr/vec:
  s mm v* |- VEC.CONST vec : (s, (VecV vec) :: v*)

rule Exec_instr/ref-null:
  s mm v* |- REF.NULL ht : (s, (RefV (NullRef ht')) :: v*)
  -- if ht' = $inst_heaptype(mm, ht)

rule Exec_instr/ref-func:
  s mm v* |- REF.FUNC x : (s, (RefV (FuncRef mm.FUNCS[x])) :: v*)

rule Exec_instr/ref-i31:
  s mm ((NumV (I32 n)) :: v*) |- REF.I31 : (s, (RefV (I31Ref ni)) :: v*)
  -- if ni = $i31_of_i32(n)

rule Exec_instr/i31-get-u:
  s mm ((RefV (I31Ref ni)) :: v*) |- I31.GET ZX : (s, (NumV (I32 ni)) :: v*)

rule Exec_instr/i31-get-s:
  s mm ((RefV (I31Ref ni)) :: v*) |- I31.GET SX : (s, (NumV (I32 n)) :: v*)
  -- if n = $i31_get_s(ni)

rule Exec_instr/ref-is-null-true:
  s mm ((RefV (NullRef ht)) :: v*) |- REF.IS_NULL : (s, (NumV (I32 1)) :: v*)

rule Exec_instr/ref-is-null-false:
  s mm ((RefV r) :: v*) |- REF.IS_NULL : (s, (NumV (I32 0)) :: v*)
  -- Ref_ok: s |- r : NoNull ht

rule Exec_instr/ref-as-non-null:
  s mm ((RefV r) :: v*) |- REF.AS_NON_NULL : (s, (RefV r) :: v*)
  -- Ref_ok: s |- r : NoNull ht

rule Exec_instr/ref-eq:
  s mm ((RefV r_2) :: (RefV r_1) :: v*) |- REF.EQ : (s, (NumV (I32 n)) :: v*)
  -- if n = $ref_eq(r_1, r_2)

rule Exec_instr/ref-test-true:
  s mm ((RefV r) :: v*) |- REF.TEST rt : (s, (NumV (I32 1)) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(mm, rt)
  -- if $match_reftype(mm.TYPES, rtactual, rt_expect)

rule Exec_instr/ref-test-false:
  s mm ((RefV r) :: v*) |- REF.TEST rt : (s, (NumV (I32 0)) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(mm, rt)
  -- if ~$match_reftype(mm.TYPES, rtactual, rt_expect)

rule Exec_instr/ref-cast:
  s mm ((RefV r) :: v*) |- REF.CAST rt : (s, (RefV r) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(mm, rt)
  -- if $match_reftype(mm.TYPES, rtactual, rt_expect)

rule Exec_instr/extern-internalize-null:
  s mm ((RefV (NullRef ht)) :: v*) |- EXTERN.CONVERT Internalize : (s, (RefV (NullRef NoneHT)) :: v*)

rule Exec_instr/extern-internalize:
  s mm ((RefV (ExternRef r)) :: v*) |- EXTERN.CONVERT Internalize : (s, (RefV r) :: v*)

rule Exec_instr/extern-externalize-null:
  s mm ((RefV (NullRef ht)) :: v*) |- EXTERN.CONVERT Externalize : (s, (RefV (NullRef NoExternHT)) :: v*)

rule Exec_instr/extern-externalize:
  s mm ((RefV r) :: v*) |- EXTERN.CONVERT Externalize : (s, (RefV (ExternRef r)) :: v*)
  -- Ref_ok: s |- r : NoNull ht

rule Exec_instr/global-get:
  s mm v* |- GLOBAL.GET x : (s, s.GLOBALS[mm.GLOBALS[x]].VALUE :: v*)

rule Exec_instr/table-get:
  s mm ((NumV (I32 i)) :: v*) |- TABLE.GET x : (s, (RefV r) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I32AT lim rt = s.TABLES[ta].TYPE
  -- if r = s.TABLES[ta].REFS[i]

rule Exec_instr/table-get-i64:
  s mm ((NumV (I64 i)) :: v*) |- TABLE.GET x : (s, (RefV r) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I64AT lim rt = s.TABLES[ta].TYPE
  -- if offset = $nat_of_num(I64 i)
  -- if r = s.TABLES[ta].REFS[offset]

rule Exec_instr/table-set:
  s mm ((RefV r) :: (NumV num) :: v*) |- TABLE.SET x : (s', v*)
  -- if ta = mm.TABLES[x]
  -- if offset = $nat_of_num(num)
  -- if $(offset < |s.TABLES[ta].REFS|)
  -- if s' = s[ .TABLES[ta].REFS[offset] = r ]

rule Exec_instr/table-size-i32:
  s mm v* |- TABLE.SIZE x : (s, (NumV (I32 n)) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I32AT lim rt = s.TABLES[ta].TYPE
  -- if n = |s.TABLES[ta].REFS|

rule Exec_instr/table-size-i64:
  s mm v* |- TABLE.SIZE x : (s, (NumV (I64 n)) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I64AT lim rt = s.TABLES[ta].TYPE
  -- if n = |s.TABLES[ta].REFS|

rule Exec_instr/table-grow-i32-unbounded:
  s mm ((NumV (I32 n)) :: (RefV r) :: v*) |- TABLE.GROW x : (s', (NumV (I32 old)) :: v*)
  -- if ta = mm.TABLES[x]
  -- if TableT I32AT { MIN i64, MAX eps } rt = s.TABLES[ta].TYPE
