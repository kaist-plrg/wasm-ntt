  -- if s_1 = s[ .MEMS[ma].BYTES = s.MEMS[ma].BYTES ++ $zero_bytes(nbytes) ]
  -- if s' = s_1[ .MEMS[ma].TYPE = MemoryT I32AT { MIN newsize, MAX eps } ]

rule Exec_instr_frame/memory-grow-i32-unbounded-fail:
  s fr ((NumV (I32 n)) :: v*) |- MEMORY.GROW x : (s, fr, (NumV (I32 4294967295)) :: v*)
