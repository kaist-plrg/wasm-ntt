;;
;; Minimal Execution of Constant Expressions
;;

relation Eval_const: store moduleinst |- const : (store, value)
  hint(input %0 %1 %2)

relation Eval_consts: store moduleinst |- const* : (store, value*)
  hint(input %0 %1 %2)

relation Exec_instr: store moduleinst value* |- instr : (store, value*)
  hint(input %0 %1 %2 %3)

relation Exec_instrs: store moduleinst value* |- instr* : (store, value*)
  hint(input %0 %1 %2 %3)

relation Exec_instr_frame: store frame value* |- instr : (store, frame, value*)
  hint(input %0 %1 %2 %3)

relation Exec_instrs_frame: store frame value* |- instr* : (store, frame, value*)
  hint(input %0 %1 %2 %3)

relation Exec_instr_ctrl: store frame value* |- instr : execresult
  hint(input %0 %1 %2 %3)

relation Exec_instrs_ctrl: store frame value* |- instr* : execresult
  hint(input %0 %1 %2 %3)

relation Invoke_funcaddr: store value* |- funcaddr : (store, value*)
  hint(input %0 %1 %2)

relation Invoke_funcaddr_throw: store value* |- funcaddr : execresult
  hint(input %0 %1 %2)

relation Invoke_ok: store funcaddr value* |- value* : store
  hint(input %0 %1 %2)

relation Handle_throw: store frame value* tagaddr value* |- catch* : execresult
  hint(input %0 %1 %2 %3 %4 %5)

rule Eval_const/exec:
  s mm |- const : (s', v)
  -- Exec_instrs: s mm eps |- const : (s', v :: eps)

rule Eval_consts/cons:
  s mm |- const_1 :: const* : (s_2, v_1 :: v*)
  -- Eval_const: s mm |- const_1 : (s_1, v_1)
  -- Eval_consts: s_1 mm |- const* : (s_2, v*)

rule Eval_consts/nil:
  s mm |- eps : (s, eps)

dec $refs_of_values(value*) : refval*
def $refs_of_values(eps) = eps
def $refs_of_values((RefV r) :: v*) = r :: $refs_of_values(v*)

dec $pack_field(storagetype, value) : fieldval
dec $pack_fields(fieldtype*, value*) : fieldval*
dec $unpack_field(fieldval) : value
dec $unpack_field_ext(fieldval, extension) : value
dec $some_values(value*) : (value?)*
dec $default_locals(moduleinst, local*) : (value?)*
dec $default_field_values(fieldtype*) : value*
dec $storage_size_nat(storagetype) : nat
dec $fieldval_of_storage_bytes(storagetype, byte*) : fieldval
dec $fieldvals_of_data(storagetype, byte*, nat, nat) : fieldval*
dec $fieldvals_of_refs(storagetype, refval*) : fieldval*
dec $ref_eq(refval, refval) : nat

def $pack_field(ValStorageT _, v) = FieldValue v
def $pack_field(PackStorageT I8, NumV (I32 n)) = PackedField I8 $byte_of_i32(n)
def $pack_field(PackStorageT I16, NumV (I32 n)) = PackedField I16 $i32_of_bytes($bytes_of_i32(n)[0:2])

def $unpack_field(FieldValue v) = v
def $unpack_field(PackedField pt n) = NumV (I32 n)

def $unpack_field_ext(FieldValue v, extension) = v
def $unpack_field_ext(PackedField I8 n, ZX) = NumV (I32 n)
def $unpack_field_ext(PackedField I16 n, ZX) = NumV (I32 n)
def $unpack_field_ext(PackedField I8 n, SX) = NumV (I32 $i32_extend_i8_s(n))
def $unpack_field_ext(PackedField I16 n, SX) = NumV (I32 $i32_extend_i16_s(n))

def $pack_fields(eps, eps) = eps
def $pack_fields((FieldT mut zt) :: yt*, v_1 :: v*) =
  $pack_field(zt, v_1) :: $pack_fields(yt*, v*)

def $some_values(eps) = eps
def $some_values(v_1 :: v*) = v_1 :: $some_values(v*)

def $default_locals(mm, eps) = eps
def $default_locals(mm, { LTYPE t } :: local*) =
  $default_value($inst_valtype(mm, t)) :: $default_locals(mm, local*)

def $default_field_values(eps) = eps
def $default_field_values((FieldT mut zt) :: yt*) =
  v_1 :: $default_field_values(yt*)
  -- if v_1 = $default_value($unpacked_storage_type(zt))

def $storage_size_nat(PackStorageT I8) = 1
def $storage_size_nat(PackStorageT I16) = 2
def $storage_size_nat(PackStorageT I32) = 4
def $storage_size_nat(PackStorageT I64) = 8
def $storage_size_nat(ValStorageT (NumT I32T)) = 4
def $storage_size_nat(ValStorageT (NumT I64T)) = 8
def $storage_size_nat(ValStorageT (NumT F32T)) = 4
def $storage_size_nat(ValStorageT (NumT F64T)) = 8
def $storage_size_nat(ValStorageT (VecT V128T)) = 16

def $fieldval_of_storage_bytes(PackStorageT I8, b*) = PackedField I8 b*[0]
def $fieldval_of_storage_bytes(PackStorageT I16, b*) = PackedField I16 $i32_of_bytes(b*)
def $fieldval_of_storage_bytes(ValStorageT (NumT I32T), b*) =
  FieldValue (NumV (I32 $i32_of_bytes(b*)))
def $fieldval_of_storage_bytes(ValStorageT (NumT I64T), b*) =
  FieldValue (NumV (I64 $i64_of_bytes(b*)))

def $fieldvals_of_data(zt, b*, offset, n) = eps
  -- if n = 0
def $fieldvals_of_data(zt, b*, offset, n) =
  fv :: $fieldvals_of_data(zt, b*, offset', n')
  -- if $(n > 0)
  -- if nsize = $storage_size_nat(zt)
  -- if fv = $fieldval_of_storage_bytes(zt, b*[offset:nsize])
  -- if offset' = $(offset + nsize)
  -- if n' = $(n - 1)

def $fieldvals_of_refs(zt, eps) = eps
def $fieldvals_of_refs(zt, r_1 :: r_t*) =
  $pack_field(zt, RefV r_1) :: $fieldvals_of_refs(zt, r_t*)

def $ref_eq(NullRef _, NullRef _) = 1
def $ref_eq(r, r) = 1
def $ref_eq(r_1, r_2) = 0
  -- otherwise

dec $block_result_arity(moduleinst, blocktype) : nat
dec $block_param_arity(moduleinst, blocktype) : nat
dec $block_input_stack(value*, nat) : value*
dec $block_outer_stack(value*, nat) : value*

def $block_result_arity(mm, ValBlockType eps) = 0
def $block_result_arity(mm, ValBlockType t) = 1
def $block_result_arity(mm, VarBlockType x) = |t_2*|
  -- if DefFuncT (FuncT t_1* t_2*) = $expanddt(mm.TYPES[x])

def $block_param_arity(mm, ValBlockType eps) = 0
def $block_param_arity(mm, ValBlockType t) = 0
def $block_param_arity(mm, VarBlockType x) = |t_1*|
  -- if DefFuncT (FuncT t_1* t_2*) = $expanddt(mm.TYPES[x])

def $block_input_stack(v*, n) = $take_<value>(v*, n)
def $block_outer_stack(v*, n) = v_rest*
  -- if nrest = $(|v*| - n)
  -- if v_rest* = v*[n:nrest]

;; A first execution subset used by instantiation start functions.
;; This follows eval.ml's stack convention: the head of value* is the top.

rule Exec_instrs/cons:
  s mm v* |- instr_1 :: instr* : (s_2, v_2*)
  -- Exec_instr: s mm v* |- instr_1 : (s_1, v_1*)
  -- Exec_instrs: s_1 mm v_1* |- instr* : (s_2, v_2*)

rule Exec_instrs/nil:
  s mm v* |- eps : (s, v*)

rule Exec_instrs_frame/cons:
  s fr v* |- instr_1 :: instr* : (s_2, fr_2, v_2*)
  -- Exec_instr_frame: s fr v* |- instr_1 : (s_1, fr_1, v_1*)
  -- Exec_instrs_frame: s_1 fr_1 v_1* |- instr* : (s_2, fr_2, v_2*)

rule Exec_instrs_frame/nil:
  s fr v* |- eps : (s, fr, v*)

rule Exec_instrs_ctrl/cons-normal:
  s fr v* |- instr_1 :: instr* : er
  -- Exec_instr_ctrl: s fr v* |- instr_1 : NormalR s_1 fr_1 v_1*
  -- Exec_instrs_ctrl: s_1 fr_1 v_1* |- instr* : er

rule Exec_instrs_ctrl/cons-break:
  s fr v* |- instr_1 :: instr* : BreakR s_1 fr_1 l v_1*
  -- Exec_instr_ctrl: s fr v* |- instr_1 : BreakR s_1 fr_1 l v_1*

rule Exec_instrs_ctrl/cons-return:
  s fr v* |- instr_1 :: instr* : ReturnR s_1 fr_1 v_1*
  -- Exec_instr_ctrl: s fr v* |- instr_1 : ReturnR s_1 fr_1 v_1*

rule Exec_instrs_ctrl/cons-throw:
  s fr v* |- instr_1 :: instr* : ThrowR s_1 fr_1 ja v_1*
  -- Exec_instr_ctrl: s fr v* |- instr_1 : ThrowR s_1 fr_1 ja v_1*

rule Exec_instrs_ctrl/nil:
  s fr v* |- eps : NormalR s fr v*

rule Exec_instr_ctrl/block-normal:
  s fr v* |- BLOCK blocktype instr* : NormalR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : NormalR s' frp v_label*
  -- if v'* = v_label* ++ v_rest*

rule Exec_instr_ctrl/block-break-zero:
  s fr v* |- BLOCK blocktype instr* : NormalR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if nresult = $block_result_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : BreakR s' frp 0 v_break*
  -- if v_take* = $take_<value>(v_break*, nresult)
  -- if v'* = v_take* ++ v_rest*

rule Exec_instr_ctrl/block-break-succ:
  s fr v* |- BLOCK blocktype instr* : BreakR s' frp l' v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : BreakR s' frp l v'*
  -- if $(l > 0)
  -- if l' = $(l - 1)

rule Exec_instr_ctrl/block-return:
  s fr v* |- BLOCK blocktype instr* : ReturnR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : ReturnR s' frp v'*

rule Exec_instr_ctrl/block-throw:
  s fr v* |- BLOCK blocktype instr* : ThrowR s' frp ja v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : ThrowR s' frp ja v'*

rule Exec_instr_ctrl/loop-normal:
  s fr v* |- LOOP blocktype instr* : NormalR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : NormalR s' frp v_label*
  -- if v'* = v_label* ++ v_rest*

rule Exec_instr_ctrl/loop-break-zero:
  s fr v* |- LOOP blocktype instr* : er
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : BreakR s_1 fr_1 0 v_1*
  -- if v_loop* = $take_<value>(v_1*, nparam) ++ v_rest*
  -- Exec_instr_ctrl: s_1 fr_1 v_loop* |- LOOP blocktype instr* : er

rule Exec_instr_ctrl/loop-break-succ:
  s fr v* |- LOOP blocktype instr* : BreakR s' frp l' v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : BreakR s' frp l v'*
  -- if $(l > 0)
  -- if l' = $(l - 1)

rule Exec_instr_ctrl/loop-return:
  s fr v* |- LOOP blocktype instr* : ReturnR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : ReturnR s' frp v'*

rule Exec_instr_ctrl/loop-throw:
  s fr v* |- LOOP blocktype instr* : ThrowR s' frp ja v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : ThrowR s' frp ja v'*

rule Exec_instr_ctrl/cond-true-normal:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : NormalR s' frp v'*
  -- if $(i =/= 0)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_1* : NormalR s' frp v_label*
  -- if v'* = v_label* ++ v_rest*

rule Exec_instr_ctrl/cond-true-break-zero:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : NormalR s' frp v'*
  -- if $(i =/= 0)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if nresult = $block_result_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_1* : BreakR s' frp 0 v_break*
  -- if v_take* = $take_<value>(v_break*, nresult)
  -- if v'* = v_take* ++ v_rest*

rule Exec_instr_ctrl/cond-true-break-succ:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : BreakR s' frp l' v'*
  -- if $(i =/= 0)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_1* : BreakR s' frp l v'*
  -- if $(l > 0)
  -- if l' = $(l - 1)

rule Exec_instr_ctrl/cond-true-return:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : ReturnR s' frp v'*
  -- if $(i =/= 0)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_1* : ReturnR s' frp v'*

rule Exec_instr_ctrl/cond-true-throw:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : ThrowR s' frp ja v'*
  -- if $(i =/= 0)
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_1* : ThrowR s' frp ja v'*

rule Exec_instr_ctrl/cond-false-normal:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : NormalR s' frp v'*
  -- if i = 0
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_2* : NormalR s' frp v_label*
  -- if v'* = v_label* ++ v_rest*

rule Exec_instr_ctrl/cond-false-break-zero:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : NormalR s' frp v'*
  -- if i = 0
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if nresult = $block_result_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_2* : BreakR s' frp 0 v_break*
  -- if v_take* = $take_<value>(v_break*, nresult)
  -- if v'* = v_take* ++ v_rest*

rule Exec_instr_ctrl/cond-false-break-succ:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : BreakR s' frp l' v'*
  -- if i = 0
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_2* : BreakR s' frp l v'*
  -- if $(l > 0)
  -- if l' = $(l - 1)

rule Exec_instr_ctrl/cond-false-return:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : ReturnR s' frp v'*
  -- if i = 0
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_2* : ReturnR s' frp v'*

rule Exec_instr_ctrl/cond-false-throw:
  s fr ((NumV (I32 i)) :: v*) |- IF blocktype instr_1* ELSE instr_2* : ThrowR s' frp ja v'*
  -- if i = 0
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr_2* : ThrowR s' frp ja v'*

rule Exec_instr_ctrl/br:
  s fr v* |- BR l : BreakR s fr l v*

rule Exec_instr_ctrl/brif-true:
  s fr ((NumV (I32 i)) :: v*) |- BR_IF l : BreakR s fr l v*
  -- if $(i =/= 0)

rule Exec_instr_ctrl/brif-false:
  s fr ((NumV (I32 i)) :: v*) |- BR_IF l : NormalR s fr v*
  -- if i = 0

rule Exec_instr_ctrl/br-table-in:
  s fr ((NumV (I32 i)) :: v*) |- BR_TABLE l* x : BreakR s fr y v*
  -- if $(i < |l*|)
  -- if y = l*[i]

rule Exec_instr_ctrl/br-table-out:
  s fr ((NumV (I32 i)) :: v*) |- BR_TABLE l* x : BreakR s fr x v*
  -- if $(i >= |l*|)

rule Exec_instr_ctrl/br-on-null-null:
  s fr ((RefV (NullRef ht)) :: v*) |- BR_ON_NULL l : BreakR s fr l v*

rule Exec_instr_ctrl/br-on-null-non-null:
  s fr ((RefV r) :: v*) |- BR_ON_NULL l : NormalR s fr ((RefV r) :: v*)
  -- Ref_ok: s |- r : NoNull ht

rule Exec_instr_ctrl/br-on-non-null-null:
  s fr ((RefV (NullRef ht)) :: v*) |- BR_ON_NON_NULL l : NormalR s fr v*

rule Exec_instr_ctrl/br-on-non-null-non-null:
  s fr ((RefV r) :: v*) |- BR_ON_NON_NULL l : BreakR s fr l ((RefV r) :: v*)
  -- Ref_ok: s |- r : NoNull ht

rule Exec_instr_ctrl/br-on-cast-true:
  s fr ((RefV r) :: v*) |- BR_ON_CAST l rt_1 rt_2 : BreakR s fr l ((RefV r) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if $match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Exec_instr_ctrl/br-on-cast-false:
  s fr ((RefV r) :: v*) |- BR_ON_CAST l rt_1 rt_2 : NormalR s fr ((RefV r) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if ~$match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Exec_instr_ctrl/br-on-cast-fail-true:
  s fr ((RefV r) :: v*) |- BR_ON_CAST_FAIL l rt_1 rt_2 : NormalR s fr ((RefV r) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if $match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Exec_instr_ctrl/br-on-cast-fail-false:
  s fr ((RefV r) :: v*) |- BR_ON_CAST_FAIL l rt_1 rt_2 : BreakR s fr l ((RefV r) :: v*)
  -- Ref_ok: s |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt_2)
  -- if ~$match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Exec_instr_ctrl/return:
  s fr v* |- RETURN : ReturnR s fr v*

rule Exec_instr_ctrl/return-call:
  s fr v* |- RETURN_CALL x : ReturnR s' fr v'*
  -- if fa = fr.MODULE.FUNCS[x]
  -- Invoke_funcaddr: s v* |- fa : (s', v'*)

rule Exec_instr_ctrl/return-call-throw:
  s fr v* |- RETURN_CALL x : ThrowR s' frp ja v_throw*
  -- if fa = fr.MODULE.FUNCS[x]
  -- Invoke_funcaddr_throw: s v* |- fa : ThrowR s' frp ja v_throw*

rule Exec_instr_ctrl/return-call-ref:
  s fr ((RefV (FuncRef fa)) :: v*) |- RETURN_CALL_REF x : ReturnR s' fr v'*
  -- Invoke_funcaddr: s v* |- fa : (s', v'*)

rule Exec_instr_ctrl/return-call-ref-throw:
  s fr ((RefV (FuncRef fa)) :: v*) |- RETURN_CALL_REF x : ThrowR s' frp ja v_throw*
  -- Invoke_funcaddr_throw: s v* |- fa : ThrowR s' frp ja v_throw*

rule Exec_instr_ctrl/return-call-indirect:
  s fr ((NumV num_i) :: v*) |- RETURN_CALL_INDIRECT x y : ReturnR s' fr v'*
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if FuncRef fa = s.TABLES[ta].REFS[i]
  -- if fi = s.FUNCS[fa]
  -- if $match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])
  -- Invoke_funcaddr: s v* |- fa : (s', v'*)

rule Exec_instr_ctrl/return-call-indirect-throw:
  s fr ((NumV num_i) :: v*) |- RETURN_CALL_INDIRECT x y : ThrowR s' frp ja v_throw*
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if FuncRef fa = s.TABLES[ta].REFS[i]
  -- if fi = s.FUNCS[fa]
  -- if $match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])
  -- Invoke_funcaddr_throw: s v* |- fa : ThrowR s' frp ja v_throw*

rule Exec_instr_ctrl/call-throw:
  s fr v* |- CALL x : ThrowR s' frp ja v_throw*
  -- if fa = fr.MODULE.FUNCS[x]
  -- Invoke_funcaddr_throw: s v* |- fa : ThrowR s' frp ja v_throw*

rule Exec_instr_ctrl/call-ref-throw:
  s fr ((RefV (FuncRef fa)) :: v*) |- CALL_REF x : ThrowR s' frp ja v_throw*
  -- Invoke_funcaddr_throw: s v* |- fa : ThrowR s' frp ja v_throw*

rule Exec_instr_ctrl/call-indirect-throw:
  s fr ((NumV num_i) :: v*) |- CALL_INDIRECT x y : ThrowR s' frp ja v_throw*
  -- if ta = fr.MODULE.TABLES[x]
  -- if i = $nat_of_num(num_i)
  -- if FuncRef fa = s.TABLES[ta].REFS[i]
  -- if fi = s.FUNCS[fa]
  -- if $match_deftype(eps, fi.TYPE, fr.MODULE.TYPES[y])
  -- Invoke_funcaddr_throw: s v* |- fa : ThrowR s' frp ja v_throw*

rule Exec_instr_ctrl/throw:
  s fr v* |- THROW x : ThrowR s fr ja v_throw*
  -- if ja = fr.MODULE.TAGS[x]
  -- if TagT dtf = s.TAGS[ja].TYPE
  -- if DefFuncT (FuncT t_arg* eps) = $expanddt(dtf)
  -- if n = |t_arg*|
  -- if v_throw* = $take_<value>(v*, n)

rule Exec_instr_ctrl/throw-ref:
  s fr ((RefV (ExnRef a)) :: v*) |- THROW_REF : ThrowR s fr s.EXNS[a].TAG s.EXNS[a].FIELDS

rule Exec_instr_ctrl/try-table-normal:
  s fr v* |- TRY_TABLE blocktype catch* instr* : NormalR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : NormalR s' frp v_label*
  -- if v'* = v_label* ++ v_rest*

rule Exec_instr_ctrl/try-table-break-zero:
  s fr v* |- TRY_TABLE blocktype catch* instr* : NormalR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if nresult = $block_result_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : BreakR s' frp 0 v_break*
  -- if v_take* = $take_<value>(v_break*, nresult)
  -- if v'* = v_take* ++ v_rest*

rule Exec_instr_ctrl/try-table-break-succ:
  s fr v* |- TRY_TABLE blocktype catch* instr* : BreakR s' frp l' v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : BreakR s' frp l v'*
  -- if $(l > 0)
  -- if l' = $(l - 1)

rule Exec_instr_ctrl/try-table-return:
  s fr v* |- TRY_TABLE blocktype catch* instr* : ReturnR s' frp v'*
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : ReturnR s' frp v'*

rule Exec_instr_ctrl/try-table-throw:
  s fr v* |- TRY_TABLE blocktype catch* instr* : er
  -- if nparam = $block_param_arity(fr.MODULE, blocktype)
  -- if v_arg* = $block_input_stack(v*, nparam)
  -- if v_rest* = $block_outer_stack(v*, nparam)
  -- Exec_instrs_ctrl: s fr v_arg* |- instr* : ThrowR s' frp ja v_throw*
  -- Handle_throw: s' frp v_rest* ja v_throw* |- catch* : er

rule Handle_throw/catch:
  s fr v_rest* ja v_throw* |- (Catch x y) :: catch* : BreakR s fr y (v_throw* ++ v_rest*)
  -- if ja = fr.MODULE.TAGS[x]

rule Handle_throw/catch-skip:
  s fr v_rest* ja v_throw* |- (Catch x y) :: catch* : er
  -- if ~(ja = fr.MODULE.TAGS[x])
  -- Handle_throw: s fr v_rest* ja v_throw* |- catch* : er

rule Handle_throw/catch-ref:
  s fr v_rest* ja v_throw* |- (CatchRef x y) :: catch* : BreakR s' fr y ((RefV (ExnRef a)) :: (v_throw* ++ v_rest*))
  -- if ja = fr.MODULE.TAGS[x]
  -- if a = |s.EXNS|
  -- if s' = s[ .EXNS = s.EXNS ++ [{ TAG ja, FIELDS v_throw* }] ]

rule Handle_throw/catch-ref-skip:
  s fr v_rest* ja v_throw* |- (CatchRef x y) :: catch* : er
  -- if ~(ja = fr.MODULE.TAGS[x])
  -- Handle_throw: s fr v_rest* ja v_throw* |- catch* : er

rule Handle_throw/catch-all:
  s fr v_rest* ja v_throw* |- (CatchAll x) :: catch* : BreakR s fr x v_rest*

rule Handle_throw/catch-all-ref:
  s fr v_rest* ja v_throw* |- (CatchAllRef x) :: catch* : BreakR s' fr x ((RefV (ExnRef a)) :: v_rest*)
  -- if a = |s.EXNS|
  -- if s' = s[ .EXNS = s.EXNS ++ [{ TAG ja, FIELDS v_throw* }] ]

rule Handle_throw/nil:
  s fr v_rest* ja v_throw* |- eps : ThrowR s fr ja v_throw*

rule Exec_instr_ctrl/plain:
  s fr v* |- instr : NormalR s' frp v'*
  -- Exec_instr_frame: s fr v* |- instr : (s', frp, v'*)

rule Invoke_funcaddr/ast:
