  -- if m = |t_result*|
  -- if v_results* = $take_<value>(v_result_stack*, m)
  -- if v'* = v_results* ++ v_rest*

rule Invoke_funcaddr_throw/ast:
  s v* |- fa : ThrowR s' frp ja v_throw*
  -- if fi = s.FUNCS[fa]
  -- if AstFunc func = fi.CODE
  -- if DefFuncT (FuncT t_arg* t_result*) = $expanddt(fi.TYPE)
  -- if n = |t_arg*|
