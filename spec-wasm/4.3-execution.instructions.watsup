;; 4.6. Instructions (pg. 122)

;; 4.6.1. Parametric Instructions
rule Step_plain_instr/nop:
  STO fr v* |- NOP : (STO, fr, v*, eps)

rule Step_plain_instr/drop:
  STO fr (v_1 :: v*) |- DROP : (STO, fr, v*, eps)

rule Step_plain_instr/select-true:
  STO fr ((NumV (I32 i)) :: v_2 :: v_1 :: v*) |- SELECT t*? : (STO, fr, v_1 :: v*, eps)
  -- if $(i =/= 0)
rule Step_plain_instr/select-false:
  STO fr ((NumV (I32 i)) :: v_2 :: v_1 :: v*) |- SELECT t*? : (STO, fr, v_2 :: v*, eps)
  -- if i = 0

rule Step_plain_instr/const:
  STO fr v* |- CONST num : (STO, fr, (NumV num) :: v*, eps)
rule Step_plain_instr/vec:
  STO fr v* |- VEC.CONST vec : (STO, fr, (VecV vec) :: v*, eps)
rule Step_plain_instr/ref-null:
  STO fr v* |- REF.NULL ht : (STO, fr, (RefV (NullRef ht')) :: v*, eps)
  -- if ht' = $inst_heaptype(fr.MODULE, ht)

rule Step_plain_instr/ref-func:
  STO fr v* |- REF.FUNC x : (STO, fr, (RefV (FuncRef fr.MODULE.FUNCS[x])) :: v*, eps)
rule Step_plain_instr/ref-i31:
  STO fr ((NumV (I32 n)) :: v*) |- REF.I31 : (STO, fr, (RefV (I31Ref ni)) :: v*, eps)
  -- if ni = $i31_of_i32(n)

rule Step_plain_instr/i31-get-u:
  STO fr ((RefV (I31Ref ni)) :: v*) |- I31.GET ZX : (STO, fr, (NumV (I32 ni)) :: v*, eps)
rule Step_plain_instr/i31-get-STO:
  STO fr ((RefV (I31Ref ni)) :: v*) |- I31.GET SX : (STO, fr, (NumV (I32 n)) :: v*, eps)
  -- if n = $i31_get_s(ni)

rule Step_plain_instr/i31-get-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- I31.GET extension :
    (STO, fr, v*, (Trapping) :: eps)

rule Step_plain_instr/ref-is-null-true:
  STO fr ((RefV (NullRef ht)) :: v*) |- REF.IS_NULL : (STO, fr, (NumV (I32 1)) :: v*, eps)
rule Step_plain_instr/ref-is-null-false:
  STO fr ((RefV r) :: v*) |- REF.IS_NULL : (STO, fr, (NumV (I32 0)) :: v*, eps)
  -- Ref_ok: STO |- r : NoNull ht

rule Step_plain_instr/ref-as-non-null:
  STO fr ((RefV r) :: v*) |- REF.AS_NON_NULL : (STO, fr, (RefV r) :: v*, eps)
  -- Ref_ok: STO |- r : NoNull ht

rule Step_plain_instr/ref-as-non-null-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- REF.AS_NON_NULL :
    (STO, fr, v*, (Trapping) :: eps)

rule Step_plain_instr/ref-eq:
  STO fr ((RefV r_2) :: (RefV r_1) :: v*) |- REF.EQ : (STO, fr, (NumV (I32 n)) :: v*, eps)
  -- if n = $ref_eq(r_1, r_2)

rule Step_plain_instr/ref-test-true:
  STO fr ((RefV r) :: v*) |- REF.TEST rt : (STO, fr, (NumV (I32 1)) :: v*, eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt)
  -- if $match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/ref-test-false:
  STO fr ((RefV r) :: v*) |- REF.TEST rt : (STO, fr, (NumV (I32 0)) :: v*, eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt)
  -- if ~$match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/ref-cast:
  STO fr ((RefV r) :: v*) |- REF.CAST rt : (STO, fr, (RefV r) :: v*, eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt)
  -- if $match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/ref-cast-fail:
  STO fr ((RefV r) :: v*) |- REF.CAST rt :
    (STO, fr, v*, (Trapping) :: eps)
  -- Ref_ok: STO |- r : rtactual
  -- if rt_expect = $inst_reftype(fr.MODULE, rt)
  -- if ~$match_reftype(fr.MODULE.TYPES, rtactual, rt_expect)

rule Step_plain_instr/extern-internalize-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- EXTERN.CONVERT Internalize : (STO, fr, (RefV (NullRef NoneHT)) :: v*, eps)
rule Step_plain_instr/extern-internalize:
  STO fr ((RefV (ExternRef r)) :: v*) |- EXTERN.CONVERT Internalize : (STO, fr, (RefV r) :: v*, eps)
rule Step_plain_instr/extern-externalize-null:
  STO fr ((RefV (NullRef ht)) :: v*) |- EXTERN.CONVERT Externalize : (STO, fr, (RefV (NullRef NoExternHT)) :: v*, eps)
rule Step_plain_instr/extern-externalize:
  STO fr ((RefV r) :: v*) |- EXTERN.CONVERT Externalize : (STO, fr, (RefV (ExternRef r)) :: v*, eps)
  -- Ref_ok: STO |- r : NoNull ht

rule Step_plain_instr/global-get:
  STO fr v* |- GLOBAL.GET x : (STO, fr, STO.GLOBALS[fr.MODULE.GLOBALS[x]].VALUE :: v*, eps)

rule Step_plain_instr/table-get:
  STO fr ((NumV (I32 i)) :: v*) |- TABLE.GET x : (STO, fr, (RefV r) :: v*, eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if TableT I32AT lim rt = STO.TABLES[ta].TYPE
  -- if $(i < |STO.TABLES[ta].REFS|)
  -- if r = STO.TABLES[ta].REFS[i]

rule Step_plain_instr/table-get-oob:
  STO fr ((NumV (I32 i)) :: v*) |- TABLE.GET x :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if TableT I32AT lim rt = STO.TABLES[ta].TYPE
  -- if $(i >= |STO.TABLES[ta].REFS|)

rule Step_plain_instr/table-get-i64:
  STO fr ((NumV (I64 i64)) :: v*) |- TABLE.GET x : (STO, fr, (RefV r) :: v*, eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if TableT I64AT lim rt = STO.TABLES[ta].TYPE
  -- if offset = $nat_of_num(I64 i64)
  -- if $(offset < |STO.TABLES[ta].REFS|)
  -- if r = STO.TABLES[ta].REFS[offset]

rule Step_plain_instr/table-get-i64-oob:
  STO fr ((NumV (I64 i64)) :: v*) |- TABLE.GET x :
    (STO, fr, v*, (Trapping) :: eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if TableT I64AT lim rt = STO.TABLES[ta].TYPE
  -- if offset = $nat_of_num(I64 i64)
  -- if $(offset >= |STO.TABLES[ta].REFS|)

rule Step_plain_instr/table-set:
  STO fr ((RefV r) :: (NumV num) :: v*) |- TABLE.SET x : (STO', fr, v*, eps)
  -- if ta = fr.MODULE.TABLES[x]
  -- if offset = $nat_of_num(num)
