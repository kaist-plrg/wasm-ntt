rule Run_start/none:
  s mm |- eps : s

rule Run_start/some:
  s mm |- { SFUNC x } : s'
  -- if fa = mm.FUNCS[x]
  -- Invoke_funcaddr: s eps |- fa : (s', eps)

rule Run_start_trap/some:
