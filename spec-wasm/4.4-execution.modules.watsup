;;
;; Execution of Modules
;;

builtin dec $bytes_of_text(text) : byte*

;; Allocation helpers

dec $alloctypes(type*) : deftype*
dec $alloctypes_from(deftype*, type*) : deftype*

def $alloctypes(type*) = $alloctypes_from(eps, type*)

def $alloctypes_from(dt*, eps) = dt*
def $alloctypes_from(dt*, type_1 :: type*) =
  $alloctypes_from(dt_all*, type*)
  -- if x = |dt*|
  -- if dt_rolled* = $rolldt(x, type_1)
  -- if dt_new* = ($subst_deftype<deftype*>(dt*, def $subst_of, dt_rolled))*
  -- if dt_all* = dt* ++ dt_new*

relation Alloc_funcs: store moduleinst deftype* |- func* : store
  hint(input %0 %1 %2 %3)

rule Alloc_funcs/cons:
  STO moduleinst dt* |- func_1 :: func* : STO_2
  -- if x = func_1.FTYPE
  -- if dtf = $deftype_at(dt*, x)
  -- if fi = { TYPE dtf, MODULE moduleinst, CODE (AstFunc func_1) }
  -- if STO_1 = STO[ .FUNCS = STO.FUNCS ++ [fi] ]
  -- Alloc_funcs: STO_1 moduleinst dt* |- func* : STO_2

rule Alloc_funcs/nil:
  STO moduleinst dt* |- eps : STO

relation Alloc_globals: store moduleinst |- global* : store
  hint(input %0 %1 %2)

rule Alloc_globals/cons:
  STO moduleinst |- global_1 :: global* : STO_2
  -- if gt = $inst_globaltype(moduleinst, global_1.GTYPE) ;; module-local type index 를 alloctypes 가 만든 runtime defined type 로 변환
  -- if GlobalT mut t = gt
  ----
  -- Eval_const: STO moduleinst |- global_1.GINIT : (STO_eval, v) ;; global initializer expression 를 실행해서 값을 얻음
  ----
  -- Val_ok: STO_eval |- v : tactual
  -- if $match_valtype(moduleinst.TYPES, tactual, t) ;; global initializer expression 를 실행한 값이 expected type 과 일치하는지 확인
  ----
  -- if gi = { TYPE gt, VALUE v }
  -- if STO_1 = STO_eval[ .GLOBALS = STO_eval.GLOBALS ++ [gi] ] ;; global instance 를 store 에 추가
  ----
  -- Alloc_globals: STO_1 moduleinst |- global* : STO_2

rule Alloc_globals/nil:
  STO moduleinst |- eps : STO

relation Alloc_tables: store moduleinst |- table* : store
  hint(input %0 %1 %2)

rule Alloc_tables/cons:
  STO moduleinst |- table_1 :: table* : STO_2
  -- if tt = $inst_tabletype(moduleinst, table_1.TTYPE)
  -- if TableT at lim rt = tt
  -- Eval_const: STO moduleinst |- table_1.TINIT : (STO_eval, RefV r)
  -- Ref_ok: STO_eval |- r : rtactual
  -- if $match_reftype(moduleinst.TYPES, rtactual, rt)
  -- if n = $limits_min_nat(lim)
  -- if tir = { TYPE tt, REFS $make_<refval>(r, n) }
  -- if STO_1 = STO_eval[ .TABLES = STO_eval.TABLES ++ [tir] ]
  -- Alloc_tables: STO_1 moduleinst |- table* : STO_2

rule Alloc_tables/nil:
  STO moduleinst |- eps : STO

relation Alloc_mems: store moduleinst |- memory* : store
  hint(input %0 %1 %2)

rule Alloc_mems/cons:
  STO moduleinst |- memory_1 :: memory* : STO_2
  -- if mt = $inst_memtype(moduleinst, memory_1.MTYPE)
  -- if MemoryT at lim = mt
  -- if pages = $limits_min_nat(lim)
  -- if n = $(pages * $page_size)
  -- if mir = { TYPE mt, BYTES $zero_bytes(n) }
  -- if STO_1 = STO[ .MEMS = STO.MEMS ++ [mir] ]
  -- Alloc_mems: STO_1 moduleinst |- memory* : STO_2

rule Alloc_mems/nil:
  STO moduleinst |- eps : STO

relation Alloc_tags: store moduleinst deftype* |- tag* : store
  hint(input %0 %1 %2 %3)

rule Alloc_tags/cons:
  STO moduleinst dt* |- tag_1 :: tag* : STO_2
  -- if x = tag_1.TGTYPE
  -- if jt = TagT ($deftype_at(dt*, x))
  -- if hir = { TYPE jt }
  -- if STO_1 = STO[ .TAGS = STO.TAGS ++ [hir] ]
  -- Alloc_tags: STO_1 moduleinst dt* |- tag* : STO_2

rule Alloc_tags/nil:
  STO moduleinst dt* |- eps : STO

relation Alloc_elems: store moduleinst |- elem* : store
  hint(input %0 %1 %2)

rule Alloc_elems/cons:
  STO moduleinst |- elem_1 :: elem* : STO_2
  -- if et = $inst_reftype(moduleinst, elem_1.ETYPE)
  -- Eval_consts: STO moduleinst |- elem_1.EINIT : (STO_eval, v*)
  -- if r* = $refs_of_values(v*)
  -- if eir = { TYPE et, REFS r* }
  -- if STO_1 = STO_eval[ .ELEMS = STO_eval.ELEMS ++ [eir] ]
  -- Alloc_elems: STO_1 moduleinst |- elem* : STO_2

rule Alloc_elems/nil:
  STO moduleinst |- eps : STO

relation Alloc_datas: store moduleinst |- data* : store
  hint(input %0 %1 %2)

rule Alloc_datas/cons:
  STO moduleinst |- data_1 :: data* : STO_2
  -- if b* = $bytes_of_text(data_1.DINIT)
  -- if dir = { BYTES b* }
  -- if STO_1 = STO[ .DATAS = STO.DATAS ++ [dir] ]
  -- Alloc_datas: STO_1 moduleinst |- data* : STO_2

rule Alloc_datas/nil:
  STO moduleinst |- eps : STO

dec $allocexport(moduleinst, export) : exportinst
def $allocexport(moduleinst, { NAME name, EDESC (FuncExport x) }) =
  { NAME name, ADDR (FuncAddr moduleinst.FUNCS[x]) }
def $allocexport(moduleinst, { NAME name, EDESC (GlobalExport x) }) =
  { NAME name, ADDR (GlobalAddr moduleinst.GLOBALS[x]) }
def $allocexport(moduleinst, { NAME name, EDESC (TableExport x) }) =
  { NAME name, ADDR (TableAddr moduleinst.TABLES[x]) }
def $allocexport(moduleinst, { NAME name, EDESC (MemExport x) }) =
  { NAME name, ADDR (MemAddr moduleinst.MEMS[x]) }
def $allocexport(moduleinst, { NAME name, EDESC (TagExport x) }) =
  { NAME name, ADDR (TagAddr moduleinst.TAGS[x]) }

dec $allocexports(moduleinst, export*) : exportinst*
def $allocexports(moduleinst, export*) = ($allocexport(moduleinst, export))*

;; Import initialization.
;; OCaml eval.ml first checks that the supplied extern list has the same length
;; as module imports, then checks each extern type before appending imported
;; instances to the module instance.

dec $import_externtype(moduleinst, import) : externtype

def $import_externtype(moduleinst, { MODULENAME _, ITEMNAME _, IDESC (FuncImport x) }) =
  ExtFunct ($deftype_at(moduleinst.TYPES, x))
def $import_externtype(moduleinst, { MODULENAME _, ITEMNAME _, IDESC (GlobalImport gt) }) =
  ExtGlobalT ($inst_globaltype(moduleinst, gt))
def $import_externtype(moduleinst, { MODULENAME _, ITEMNAME _, IDESC (TableImport tt) }) =
  ExtTableT ($inst_tabletype(moduleinst, tt))
def $import_externtype(moduleinst, { MODULENAME _, ITEMNAME _, IDESC (MemImport mt) }) =
  ExtMemoryT ($inst_memtype(moduleinst, mt))
def $import_externtype(moduleinst, { MODULENAME _, ITEMNAME _, IDESC (TagImport x) }) =
  ExtTagT (TagT ($deftype_at(moduleinst.TYPES, x)))

relation Import_match_ok: store moduleinst |- externaddr import : OK
  hint(input %0 %1 %2 %3)
relation Imports_match_ok: store moduleinst |- externaddr* import* : OK
  hint(input %0 %1 %2 %3)

rule Import_match_ok:
  STO moduleinst |- xa import : OK
  -- Externaddr_ok: STO |- xa : xt_actual
  -- if xt_expect = $import_externtype(moduleinst, import)
  -- if $match_externtype(moduleinst.TYPES, xt_actual, xt_expect)

rule Imports_match_ok/cons:
  STO moduleinst |- externaddr* import* : OK
  -- if xa :: xa_t* = externaddr*
  -- if import_1 :: import_t* = import*
  -- Import_match_ok: STO moduleinst |- xa import_1 : OK
  -- Imports_match_ok: STO moduleinst |- xa_t* import_t* : OK

rule Imports_match_ok/nil:
  STO moduleinst |- externaddr* import* : OK
  -- if externaddr* = eps
  -- if import* = eps

;; Active segment execution required by instantiation.

relation Run_elem: store moduleinst elemidx |- elem : store
  hint(input %0 %1 %2 %3)
relation Run_elems_from: store moduleinst elemidx |- elem* : store
  hint(input %0 %1 %2 %3)
relation Run_elem_trap: store moduleinst elemidx |- elem : store
  hint(input %0 %1 %2 %3)
relation Run_elems_trap_from: store moduleinst elemidx |- elem* : store
  hint(input %0 %1 %2 %3)
relation Run_data: store moduleinst dataidx |- data : store
  hint(input %0 %1 %2 %3)
relation Run_datas_from: store moduleinst dataidx |- data* : store
  hint(input %0 %1 %2 %3)
relation Run_data_trap: store moduleinst dataidx |- data : store
  hint(input %0 %1 %2 %3)
relation Run_datas_trap_from: store moduleinst dataidx |- data* : store
  hint(input %0 %1 %2 %3)
relation Run_start: store moduleinst |- start? : store
  hint(input %0 %1 %2)
relation Run_start_trap: store moduleinst |- start? : store
  hint(input %0 %1 %2)

rule Run_elem/passive:
  STO moduleinst i |- { ETYPE _, EINIT _, EMODE Passive } : STO

rule Run_elem/declarative:
  STO moduleinst i |- { ETYPE _, EINIT _, EMODE Declarative } : STO'
  -- if ea = moduleinst.ELEMS[i]
  -- if STO' = STO[ .ELEMS[ea].REFS = eps ]

rule Run_elem/active:
  STO moduleinst i |- { ETYPE _, EINIT _, EMODE (Active { INDEX x, OFFSET const }) } : STO'
  -- Eval_const: STO moduleinst |- const : (STO_eval, NumV num)
  -- if offset = $nat_of_num(num)
  -- if ea = moduleinst.ELEMS[i]
  -- if ta = moduleinst.TABLES[x]
  -- if r* = STO_eval.ELEMS[ea].REFS
  -- if n = |r*|
  -- if $(offset + n <= |STO_eval.TABLES[ta].REFS|)
  -- if STO_1 = STO_eval[ .TABLES[ta].REFS = $replace_slice_<refval>(STO_eval.TABLES[ta].REFS, offset, r*) ]
  -- if STO' = STO_1[ .ELEMS[ea].REFS = eps ]

rule Run_elems_from/cons:
  STO moduleinst i |- elem_1 :: elem* : STO_2
  -- Run_elem: STO moduleinst i |- elem_1 : STO_1
  -- if i' = $(i + 1)
  -- Run_elems_from: STO_1 moduleinst i' |- elem* : STO_2

rule Run_elems_from/nil:
  STO moduleinst i |- eps : STO

rule Run_elem_trap/active-oob:
  STO moduleinst i |- { ETYPE _, EINIT _, EMODE (Active { INDEX x, OFFSET const }) } : STO_eval
  -- Eval_const: STO moduleinst |- const : (STO_eval, NumV num)
  -- if offset = $nat_of_num(num)
  -- if ea = moduleinst.ELEMS[i]
  -- if ta = moduleinst.TABLES[x]
  -- if r* = STO_eval.ELEMS[ea].REFS
  -- if n = |r*|
  -- if $(offset + n > |STO_eval.TABLES[ta].REFS|)

rule Run_elems_trap_from/head:
  STO moduleinst i |- elem_1 :: elem* : STO_trap
  -- Run_elem_trap: STO moduleinst i |- elem_1 : STO_trap

rule Run_elems_trap_from/tail:
  STO moduleinst i |- elem_1 :: elem* : STO_trap
  -- Run_elem: STO moduleinst i |- elem_1 : STO_1
  -- if i' = $(i + 1)
  -- Run_elems_trap_from: STO_1 moduleinst i' |- elem* : STO_trap

rule Run_data/passive:
  STO moduleinst i |- { DINIT _, DMODE Passive } : STO

rule Run_data/active:
  STO moduleinst i |- { DINIT _, DMODE (Active { INDEX x, OFFSET const }) } : STO'
  -- Eval_const: STO moduleinst |- const : (STO_eval, NumV num)
  -- if offset = $nat_of_num(num)
  -- if da = moduleinst.DATAS[i]
  -- if ma = moduleinst.MEMS[x]
  -- if b* = STO_eval.DATAS[da].BYTES
  -- if n = |b*|
