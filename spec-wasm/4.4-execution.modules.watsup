dec $allocexport(moduleinst, export) : exportinst
def $allocexport(mm, { NAME name, EDESC (FuncExport x) }) =
  { NAME name, ADDR (FuncAddr mm.FUNCS[x]) }
def $allocexport(mm, { NAME name, EDESC (GlobalExport x) }) =
  { NAME name, ADDR (GlobalAddr mm.GLOBALS[x]) }
def $allocexport(mm, { NAME name, EDESC (TableExport x) }) =
  { NAME name, ADDR (TableAddr mm.TABLES[x]) }
def $allocexport(mm, { NAME name, EDESC (MemExport x) }) =
  { NAME name, ADDR (MemAddr mm.MEMS[x]) }
def $allocexport(mm, { NAME name, EDESC (TagExport x) }) =
  { NAME name, ADDR (TagAddr mm.TAGS[x]) }

dec $allocexports(moduleinst, export*) : exportinst*
def $allocexports(mm, export*) = ($allocexport(mm, export))*

;; Import initialization.
;; OCaml eval.ml first checks that the supplied extern list has the same length
;; as module imports, then checks each extern type before appending imported
;; instances to the module instance.

dec $import_externtype(moduleinst, import) : externtype

def $import_externtype(mm, { MODULENAME _, ITEMNAME _, IDESC (FuncImport x) }) =
  ExtFunct ($deftype_at(mm.TYPES, x))
def $import_externtype(mm, { MODULENAME _, ITEMNAME _, IDESC (GlobalImport gt) }) =
  ExtGlobalT ($inst_globaltype(mm, gt))
def $import_externtype(mm, { MODULENAME _, ITEMNAME _, IDESC (TableImport tt) }) =
  ExtTableT ($inst_tabletype(mm, tt))
def $import_externtype(mm, { MODULENAME _, ITEMNAME _, IDESC (MemImport mt) }) =
  ExtMemoryT ($inst_memtype(mm, mt))
def $import_externtype(mm, { MODULENAME _, ITEMNAME _, IDESC (TagImport x) }) =
  ExtTagT (TagT ($deftype_at(mm.TYPES, x)))

relation Import_match_ok: store moduleinst |- externaddr import : OK
  hint(input %0 %1 %2 %3)
relation Imports_match_ok: store moduleinst |- externaddr* import* : OK
  hint(input %0 %1 %2 %3)

rule Import_match_ok:
  s mm |- xa import : OK
  -- Externaddr_ok: s |- xa : xt_actual
  -- if xt_expect = $import_externtype(mm, import)
  -- if $match_externtype(mm.TYPES, xt_actual, xt_expect)

rule Imports_match_ok/cons:
  s mm |- externaddr* import* : OK
  -- if xa :: xa_t* = externaddr*
  -- if import_1 :: import_t* = import*
  -- Import_match_ok: s mm |- xa import_1 : OK
  -- Imports_match_ok: s mm |- xa_t* import_t* : OK

rule Imports_match_ok/nil:
  s mm |- externaddr* import* : OK
  -- if externaddr* = eps
  -- if import* = eps

;; Active segment execution required by instantiation.

relation Run_elem: store moduleinst elemidx |- elem : store
  hint(input %0 %1 %2 %3)
relation Run_elems_from: store moduleinst elemidx |- elem* : store
  hint(input %0 %1 %2 %3)
relation Run_elem_trap: store moduleinst elemidx |- elem : store
  hint(input %0 %1 %2 %3)
relation Run_elems_trap_from: store moduleinst elemidx |- elem* : store
  hint(input %0 %1 %2 %3)
relation Run_data: store moduleinst dataidx |- data : store
  hint(input %0 %1 %2 %3)
relation Run_datas_from: store moduleinst dataidx |- data* : store
  hint(input %0 %1 %2 %3)
relation Run_data_trap: store moduleinst dataidx |- data : store
  hint(input %0 %1 %2 %3)
relation Run_datas_trap_from: store moduleinst dataidx |- data* : store
  hint(input %0 %1 %2 %3)
relation Run_start: store moduleinst |- start? : store
  hint(input %0 %1 %2)
relation Run_start_trap: store moduleinst |- start? : store
  hint(input %0 %1 %2)

rule Run_elem/passive:
  s mm i |- { ETYPE _, EINIT _, EMODE Passive } : s

rule Run_elem/declarative:
  s mm i |- { ETYPE _, EINIT _, EMODE Declarative } : s'
  -- if ea = mm.ELEMS[i]
  -- if s' = s[ .ELEMS[ea].REFS = eps ]

rule Run_elem/active:
  s mm i |- { ETYPE _, EINIT _, EMODE (Active { INDEX x, OFFSET const }) } : s'
  -- Eval_const: s mm |- const : (s_eval, NumV num)
  -- if offset = $nat_of_num(num)
  -- if ea = mm.ELEMS[i]
  -- if ta = mm.TABLES[x]
  -- if r* = s_eval.ELEMS[ea].REFS
  -- if n = |r*|
  -- if $(offset + n <= |s_eval.TABLES[ta].REFS|)
  -- if s_1 = s_eval[ .TABLES[ta].REFS = $replace_slice_<refval>(s_eval.TABLES[ta].REFS, offset, r*) ]
  -- if s' = s_1[ .ELEMS[ea].REFS = eps ]

rule Run_elems_from/cons:
  s mm i |- elem_1 :: elem* : s_2
  -- Run_elem: s mm i |- elem_1 : s_1
  -- if i' = $(i + 1)
  -- Run_elems_from: s_1 mm i' |- elem* : s_2

rule Run_elems_from/nil:
  s mm i |- eps : s

rule Run_elem_trap/active-oob:
  s mm i |- { ETYPE _, EINIT _, EMODE (Active { INDEX x, OFFSET const }) } : s_eval
  -- Eval_const: s mm |- const : (s_eval, NumV num)
  -- if offset = $nat_of_num(num)
  -- if ea = mm.ELEMS[i]
  -- if ta = mm.TABLES[x]
  -- if r* = s_eval.ELEMS[ea].REFS
  -- if n = |r*|
  -- if $(offset + n > |s_eval.TABLES[ta].REFS|)

rule Run_elems_trap_from/head:
  s mm i |- elem_1 :: elem* : s_trap
  -- Run_elem_trap: s mm i |- elem_1 : s_trap

rule Run_elems_trap_from/tail:
  s mm i |- elem_1 :: elem* : s_trap
  -- Run_elem: s mm i |- elem_1 : s_1
  -- if i' = $(i + 1)
  -- Run_elems_trap_from: s_1 mm i' |- elem* : s_trap

rule Run_data/passive:
  s mm i |- { DINIT _, DMODE Passive } : s

rule Run_data/active:
  s mm i |- { DINIT _, DMODE (Active { INDEX x, OFFSET const }) } : s'
