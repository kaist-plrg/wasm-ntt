  -- if fa = mm.FUNCS[x]

;; Instantiation relations.
;; Init_with_store_ok makes the OCaml heap/store explicit. Init_ok is the public
;; wrapper matching init's visible module + extern list -> module instance shape.

relation Init_allocated: store module externaddr* |- moduleinst : store
  hint(input %0 %1 %2)
relation Init_with_store_ok: store module externaddr* |- moduleinst : store
  hint(input %0 %1 %2)
relation Init_trap_with_store_ok: store module externaddr* |- store
  hint(input %0 %1 %2)
relation Init_ok: module externaddr* |- moduleinst : OK
  hint(input %0 %1)
relation Module_init_ok: |- module : moduleinst
  hint(input %0)
relation Modules_init_ok: |- module* : OK
  hint(input %0)

rule Init_allocated:
  s_0 module externaddr* |- mm : s_7
  -- Module_ok: |- module : OK
  -- if dt* = $alloctypes(module.TYPES)
  -- if fa_import* = $externaddr_funcaddr(externaddr*)
  -- if ga_import* = $externaddr_globaladdr(externaddr*)
  -- if ta_import* = $externaddr_tableaddr(externaddr*)
  -- if ma_import* = $externaddr_memaddr(externaddr*)
  -- if ja_import* = $externaddr_tagaddr(externaddr*)
  -- if fa* = fa_import* ++ $range_from(|s_0.FUNCS|, |module.FUNCS|)
  -- if ga* = ga_import* ++ $range_from(|s_0.GLOBALS|, |module.GLOBALS|)
  -- if ta* = ta_import* ++ $range_from(|s_0.TABLES|, |module.TABLES|)
  -- if ma* = ma_import* ++ $range_from(|s_0.MEMS|, |module.MEMS|)
  -- if ja* = ja_import* ++ $range_from(|s_0.TAGS|, |module.TAGS|)
  -- if ea* = $range_from(|s_0.ELEMS|, |module.ELEMS|)
  -- if da* = $range_from(|s_0.DATAS|, |module.DATAS|)
  -- if mmbase = {
      TYPES dt*,
      FUNCS fa*,
      GLOBALS ga*,
      TABLES ta*,
      MEMS ma*,
      TAGS ja*,
      ELEMS ea*,
      DATAS da*,
      EXPORTS eps
    }
  -- Imports_match_ok: s_0 mmbase |- externaddr* module.IMPORTS : OK
  -- if xi* = $allocexports(mmbase, module.EXPORTS)
  -- if mm = mmbase[ .EXPORTS = xi* ]
  -- Alloc_funcs: s_0 mm dt* |- module.FUNCS : s_1
  -- Alloc_globals: s_1 mm |- module.GLOBALS : s_2
  -- Alloc_tables: s_2 mm |- module.TABLES : s_3
  -- Alloc_mems: s_3 mm |- module.MEMS : s_4
  -- Alloc_tags: s_4 mm dt* |- module.TAGS : s_5
  -- Alloc_elems: s_5 mm |- module.ELEMS : s_6
  -- Alloc_datas: s_6 mm |- module.DATAS : s_7

rule Init_with_store_ok:
  s_0 module externaddr* |- mm : s_final
  -- Module_ok: |- module : OK
  -- if dt* = $alloctypes(module.TYPES) ;; eval.ml, line 1176, init_type
  -- if fa_import* = $externaddr_funcaddr(externaddr*)
  -- if ga_import* = $externaddr_globaladdr(externaddr*)
  -- if ta_import* = $externaddr_tableaddr(externaddr*)
  -- if ma_import* = $externaddr_memaddr(externaddr*)
  -- if ja_import* = $externaddr_tagaddr(externaddr*)
  -- if fa* = fa_import* ++ $range_from(|s_0.FUNCS|, |module.FUNCS|)
  -- if ga* = ga_import* ++ $range_from(|s_0.GLOBALS|, |module.GLOBALS|)
  -- if ta* = ta_import* ++ $range_from(|s_0.TABLES|, |module.TABLES|)
  -- if ma* = ma_import* ++ $range_from(|s_0.MEMS|, |module.MEMS|)
  -- if ja* = ja_import* ++ $range_from(|s_0.TAGS|, |module.TAGS|)
  -- if ea* = $range_from(|s_0.ELEMS|, |module.ELEMS|)
  -- if da* = $range_from(|s_0.DATAS|, |module.DATAS|)
  -- if mmbase = {
      TYPES dt*,
      FUNCS fa*,
      GLOBALS ga*,
      TABLES ta*,
      MEMS ma*,
      TAGS ja*,
      ELEMS ea*,
      DATAS da*,
      EXPORTS eps
    }
  -- Imports_match_ok: s_0 mmbase |- externaddr* module.IMPORTS : OK
  -- if xi* = $allocexports(mmbase, module.EXPORTS)
  -- if mm = mmbase[ .EXPORTS = xi* ]
  -- Alloc_funcs: s_0 mm dt* |- module.FUNCS : s_1
  -- Alloc_globals: s_1 mm |- module.GLOBALS : s_2
  -- Alloc_tables: s_2 mm |- module.TABLES : s_3
  -- Alloc_mems: s_3 mm |- module.MEMS : s_4
  -- Alloc_tags: s_4 mm dt* |- module.TAGS : s_5
  -- Alloc_elems: s_5 mm |- module.ELEMS : s_6
  -- Alloc_datas: s_6 mm |- module.DATAS : s_7
  -- Run_elems_from: s_7 mm 0 |- module.ELEMS : s_8
  -- Run_datas_from: s_8 mm 0 |- module.DATAS : s_9
  -- Run_start: s_9 mm |- module.START : s_final

rule Init_trap_with_store_ok/elem:
  s_0 module externaddr* |- s_trap
  -- Init_allocated: s_0 module externaddr* |- mm : s_7
  -- Run_elems_trap_from: s_7 mm 0 |- module.ELEMS : s_trap

rule Init_trap_with_store_ok/data:
  s_0 module externaddr* |- s_trap
  -- Init_allocated: s_0 module externaddr* |- mm : s_7
  -- Run_elems_from: s_7 mm 0 |- module.ELEMS : s_8
  -- Run_datas_trap_from: s_8 mm 0 |- module.DATAS : s_trap

rule Init_trap_with_store_ok/start:
  s_0 module externaddr* |- s_trap
  -- Init_allocated: s_0 module externaddr* |- mm : s_7
  -- Run_elems_from: s_7 mm 0 |- module.ELEMS : s_8
  -- Run_datas_from: s_8 mm 0 |- module.DATAS : s_9
  -- Run_start_trap: s_9 mm |- module.START : s_trap

rule Init_ok:
  module externaddr* |- mm : OK
  -- Init_with_store_ok: $empty_store module externaddr* |- mm : s

rule Module_init_ok:
  |- module : mm
  -- Init_ok: module eps |- mm : OK

rule Modules_init_ok/cons:
  |- module* : OK
  -- (Module_init_ok: |- module : mm)*

rule Modules_init_ok/nil:
  |- eps : OK
