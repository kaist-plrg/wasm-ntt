  -- if fa = moduleinst.FUNCS[x]
  -- Invoke: STO fa eps |- TrapO STO'

;; Instantiation relations.
;; Init_with_store_ok makes the OCaml heap/store explicit. Init_ok is the public
;; wrapper matching init's visible module + extern list -> module instance shape.

relation Init_allocated: store module externaddr* |- moduleinst : store
  hint(input %0 %1 %2)
relation Init_with_store_ok: store module externaddr* |- moduleinst : store
  hint(input %0 %1 %2)
relation Init_trap_with_store_ok: store module externaddr* |- store
  hint(input %0 %1 %2)
relation Init_ok: module externaddr* |- moduleinst : OK
  hint(input %0 %1)
relation Module_init_ok: |- module : moduleinst
  hint(input %0)
relation Modules_init_ok: |- module* : OK
  hint(input %0)

rule Init_allocated:
  STO_0 module externaddr* |- moduleinst : STO_7
  -- Module_ok: |- module : OK
  -- if dt* = $alloctypes(module.TYPES)
  -- if fa_import* = $externaddr_funcaddr(externaddr*)
  -- if ga_import* = $externaddr_globaladdr(externaddr*)
  -- if ta_import* = $externaddr_tableaddr(externaddr*)
  -- if ma_import* = $externaddr_memaddr(externaddr*)
  -- if ja_import* = $externaddr_tagaddr(externaddr*)
  -- if fa* = fa_import* ++ $range_from(|STO_0.FUNCS|, |module.FUNCS|)
  -- if ga* = ga_import* ++ $range_from(|STO_0.GLOBALS|, |module.GLOBALS|)
  -- if ta* = ta_import* ++ $range_from(|STO_0.TABLES|, |module.TABLES|)
  -- if ma* = ma_import* ++ $range_from(|STO_0.MEMS|, |module.MEMS|)
  -- if ja* = ja_import* ++ $range_from(|STO_0.TAGS|, |module.TAGS|)
  -- if ea* = $range_from(|STO_0.ELEMS|, |module.ELEMS|)
  -- if da* = $range_from(|STO_0.DATAS|, |module.DATAS|)
  -- if moduleinst_0 = {
      TYPES dt*,
      FUNCS fa*,
      GLOBALS ga*,
      TABLES ta*,
      MEMS ma*,
      TAGS ja*,
      ELEMS ea*,
      DATAS da*,
      EXPORTS eps
    }
  -- Imports_match_ok: STO_0 moduleinst_0 |- externaddr* module.IMPORTS : OK
  -- if xi* = $allocexports(moduleinst_0, module.EXPORTS)
  -- if moduleinst = moduleinst_0[ .EXPORTS = xi* ]
  -- Alloc_funcs: STO_0 moduleinst dt* |- module.FUNCS : STO_1
  -- Alloc_globals: STO_1 moduleinst |- module.GLOBALS : STO_2
  -- Alloc_tables: STO_2 moduleinst |- module.TABLES : STO_3
  -- Alloc_mems: STO_3 moduleinst |- module.MEMS : STO_4
  -- Alloc_tags: STO_4 moduleinst dt* |- module.TAGS : STO_5
  -- Alloc_elems: STO_5 moduleinst |- module.ELEMS : STO_6
  -- Alloc_datas: STO_6 moduleinst |- module.DATAS : STO_7

rule Init_with_store_ok:
  STO_0 module externaddr* |- moduleinst : STO_final
  -- Module_ok: |- module : OK ;; 1. Check if module is valid
  ----
  -- if dt* = $alloctypes(module.TYPES) ;; eval.ml, line 1176, init_type, spec page 172. #8
  ;; Extract the externaddr* by type; funcaddr, globaladdr, tableaddr, memaddr, tagaddr.
  -- if fa_import* = $externaddr_funcaddr(externaddr*)
  -- if ga_import* = $externaddr_globaladdr(externaddr*)
  -- if ta_import* = $externaddr_tableaddr(externaddr*)
  -- if ma_import* = $externaddr_memaddr(externaddr*)
  -- if ja_import* = $externaddr_tagaddr(externaddr*)
  ----
  ;; Concatenate the imported externaddr* with the newly allocated module instance's own addresses.
  -- if fa* = fa_import* ++ $range_from(|STO_0.FUNCS|, |module.FUNCS|)
  -- if ga* = ga_import* ++ $range_from(|STO_0.GLOBALS|, |module.GLOBALS|)
  -- if ta* = ta_import* ++ $range_from(|STO_0.TABLES|, |module.TABLES|)
  -- if ma* = ma_import* ++ $range_from(|STO_0.MEMS|, |module.MEMS|)
  -- if ja* = ja_import* ++ $range_from(|STO_0.TAGS|, |module.TAGS|)
  -- if ea* = $range_from(|STO_0.ELEMS|, |module.ELEMS|)
  -- if da* = $range_from(|STO_0.DATAS|, |module.DATAS|)
  ;; 여기까지 static index 를 runtime address 로 변환하는 표는 이미 완성이 된 것임.
  ;; 실제 runtime object 를 store 에 추가하는 것은 아래에서 수행됨.
  ----
  ;; Prepare the moduleinst_0 to evaluate the initializer
  -- if moduleinst_0 = {
      TYPES dt*,
      FUNCS fa*,
      GLOBALS ga*,
      TABLES ta*,
      MEMS ma*,
      TAGS ja*,
      ELEMS ea*,
      DATAS da*,
      EXPORTS eps
    }
  ----
  -- Imports_match_ok: STO_0 moduleinst_0 |- externaddr* module.IMPORTS : OK ;; 2. Check if the arity and types of the given externaddr* match the module's import declarations
  ----
  -- if xi* = $allocexports(moduleinst_0, module.EXPORTS)
  -- if moduleinst = moduleinst_0[ .EXPORTS = xi* ]
  ----
  ;; 실제 runtime object 를 store 에 채우는 과정
  -- Alloc_funcs: STO_0 moduleinst dt* |- module.FUNCS : STO_1
  -- Alloc_globals: STO_1 moduleinst |- module.GLOBALS : STO_2
  -- Alloc_tables: STO_2 moduleinst |- module.TABLES : STO_3
  -- Alloc_mems: STO_3 moduleinst |- module.MEMS : STO_4
  -- Alloc_tags: STO_4 moduleinst dt* |- module.TAGS : STO_5
  -- Alloc_elems: STO_5 moduleinst |- module.ELEMS : STO_6
  -- Alloc_datas: STO_6 moduleinst |- module.DATAS : STO_7
  ----
  -- Run_elems_from: STO_7 moduleinst 0 |- module.ELEMS : STO_8
  -- Run_datas_from: STO_8 moduleinst 0 |- module.DATAS : STO_9
  -- Run_start: STO_9 moduleinst |- module.START : STO_final

rule Init_trap_with_store_ok/elem:
  STO_0 module externaddr* |- STO_trap
  -- Init_allocated: STO_0 module externaddr* |- moduleinst : STO_7
  -- Run_elems_trap_from: STO_7 moduleinst 0 |- module.ELEMS : STO_trap

rule Init_trap_with_store_ok/data:
  STO_0 module externaddr* |- STO_trap
  -- Init_allocated: STO_0 module externaddr* |- moduleinst : STO_7
  -- Run_elems_from: STO_7 moduleinst 0 |- module.ELEMS : STO_8
  -- Run_datas_trap_from: STO_8 moduleinst 0 |- module.DATAS : STO_trap

rule Init_trap_with_store_ok/start:
  STO_0 module externaddr* |- STO_trap
  -- Init_allocated: STO_0 module externaddr* |- moduleinst : STO_7
  -- Run_elems_from: STO_7 moduleinst 0 |- module.ELEMS : STO_8
  -- Run_datas_from: STO_8 moduleinst 0 |- module.DATAS : STO_9
  -- Run_start_trap: STO_9 moduleinst |- module.START : STO_trap

rule Init_ok:
  module externaddr* |- moduleinst : OK
  -- Init_with_store_ok: $empty_store module externaddr* |- moduleinst : STO

rule Module_init_ok:
  |- module : moduleinst
  -- Init_ok: module eps |- moduleinst : OK

rule Modules_init_ok/cons:
  |- module* : OK
  -- (Module_init_ok: |- module : moduleinst)*

rule Modules_init_ok/nil:
  |- eps : OK
