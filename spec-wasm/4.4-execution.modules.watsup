rule Run_start/none:
  STO moduleinst |- eps : STO

rule Run_start/some:
  STO moduleinst |- { SFUNC x } : STO'
  -- if fa = moduleinst.FUNCS[x]
  -- Invoke: STO fa eps |- ValuesO STO' eps

rule Run_start_trap/some:
