  -- if gi = { TYPE gt, VALUE v }
  -- if s_1 = s_eval[ .GLOBALS = s_eval.GLOBALS ++ [gi] ]
  -- Alloc_globals: s_1 mm |- global* : s_2

rule Alloc_globals/nil:
  s mm |- eps : s

