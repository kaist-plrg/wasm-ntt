;;
;; Execution of Modules
;;

builtin dec $bytes_of_text(text) : byte*

;; Allocation helpers

dec $alloctypes(type*) : deftype*
dec $alloctypes_from(deftype*, type*) : deftype*

def $alloctypes(type*) = $alloctypes_from(eps, type*)

def $alloctypes_from(dt*, eps) = dt*
def $alloctypes_from(dt*, type_1 :: type*) =
  $alloctypes_from(dt_all*, type*)
  -- if x = |dt*|
  -- if dt_rolled* = $rolldt(x, type_1)
  -- if dt_new* = ($subst_deftype<deftype*>(dt*, def $subst_of, dt_rolled))*
  -- if dt_all* = dt* ++ dt_new*

relation Alloc_funcs: store moduleinst deftype* |- func* : store
  hint(input %0 %1 %2 %3)

rule Alloc_funcs/cons:
  s mm dt* |- func_1 :: func* : s_2
  -- if x = func_1.FTYPE
  -- if dtf = $deftype_at(dt*, x)
  -- if fi = { TYPE dtf, MODULE mm, CODE (AstFunc func_1) }
  -- if s_1 = s[ .FUNCS = s.FUNCS ++ [fi] ]
  -- Alloc_funcs: s_1 mm dt* |- func* : s_2

rule Alloc_funcs/nil:
  s mm dt* |- eps : s

relation Alloc_globals: store moduleinst |- global* : store
