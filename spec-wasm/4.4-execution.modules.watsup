rule Run_datas_from/cons:
  STO moduleinst i |- data_1 :: data* : STO_2
  -- Run_data: STO moduleinst i |- data_1 : STO_1
  -- if i' = $(i + 1)
  -- Run_datas_from: STO_1 moduleinst i' |- data* : STO_2

rule Run_datas_from/nil:
