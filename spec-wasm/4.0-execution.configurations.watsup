def $externaddr_memaddr((FuncAddr _) :: xa*) = $externaddr_memaddr(xa*)
def $externaddr_memaddr((GlobalAddr _) :: xa*) = $externaddr_memaddr(xa*)
def $externaddr_memaddr((TableAddr _) :: xa*) = $externaddr_memaddr(xa*)
def $externaddr_memaddr((TagAddr _) :: xa*) = $externaddr_memaddr(xa*)

def $externaddr_tagaddr(eps) = eps
def $externaddr_tagaddr((TagAddr a) :: xa*) = a :: $externaddr_tagaddr(xa*)
def $externaddr_tagaddr((FuncAddr _) :: xa*) = $externaddr_tagaddr(xa*)
