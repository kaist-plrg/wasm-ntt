dec $externaddr_funcaddr(externaddr*) : funcaddr*
dec $externaddr_globaladdr(externaddr*) : globaladdr*
dec $externaddr_tableaddr(externaddr*) : tableaddr*
dec $externaddr_memaddr(externaddr*) : memaddr*
dec $externaddr_tagaddr(externaddr*) : tagaddr*

def $externaddr_funcaddr(eps) = eps
def $externaddr_funcaddr((FuncAddr a) :: xa*) = a :: $externaddr_funcaddr(xa*)
def $externaddr_funcaddr((GlobalAddr _) :: xa*) = $externaddr_funcaddr(xa*)
def $externaddr_funcaddr((TableAddr _) :: xa*) = $externaddr_funcaddr(xa*)
def $externaddr_funcaddr((MemAddr _) :: xa*) = $externaddr_funcaddr(xa*)
def $externaddr_funcaddr((TagAddr _) :: xa*) = $externaddr_funcaddr(xa*)

