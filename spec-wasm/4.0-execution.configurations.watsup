def $externaddr_tableaddr((FuncAddr _) :: xa*) = $externaddr_tableaddr(xa*)
def $externaddr_tableaddr((GlobalAddr _) :: xa*) = $externaddr_tableaddr(xa*)
def $externaddr_tableaddr((MemAddr _) :: xa*) = $externaddr_tableaddr(xa*)
def $externaddr_tableaddr((TagAddr _) :: xa*) = $externaddr_tableaddr(xa*)

