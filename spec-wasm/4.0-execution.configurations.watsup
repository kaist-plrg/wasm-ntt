def $externaddr_globaladdr((FuncAddr _) :: xa*) = $externaddr_globaladdr(xa*)
def $externaddr_globaladdr((TableAddr _) :: xa*) = $externaddr_globaladdr(xa*)
def $externaddr_globaladdr((MemAddr _) :: xa*) = $externaddr_globaladdr(xa*)
def $externaddr_globaladdr((TagAddr _) :: xa*) = $externaddr_globaladdr(xa*)

