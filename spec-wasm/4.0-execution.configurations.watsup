;;
;; Execution Configurations
;;

;; Addresses

syntax byte = nat

syntax addr = nat
syntax funcaddr = addr
syntax globaladdr = addr
syntax tableaddr = addr
syntax memaddr = addr
syntax tagaddr = addr
syntax elemaddr = addr
syntax dataaddr = addr
syntax hostaddr = addr
syntax structaddr = addr
syntax arrayaddr = addr
syntax exnaddr = addr

syntax externaddr =
  | FuncAddr funcaddr
  | GlobalAddr globaladdr
  | TableAddr tableaddr
  | MemAddr memaddr
  | TagAddr tagaddr

;; Runtime values

syntax refval =
  | NullRef heaptype
  | FuncRef funcaddr
  | ExternRef refval
  | I31Ref nat
  | StructRef structaddr
  | ArrayRef arrayaddr
  | ExnRef exnaddr
  | HostRef hostaddr

syntax value =
  | NumV num_
  | VecV vec_
  | RefV refval

syntax result =
  | Values value*
  | Trap

;; Runtime instances

syntax hostfunc = HostFuncId hostaddr

syntax funccode =
  | AstFunc func
  | HostFunc hostfunc

syntax exportinst = {
  NAME name,
  ADDR externaddr
}

syntax moduleinst = {
  TYPES deftype*,
  FUNCS funcaddr*,
  GLOBALS globaladdr*,
  TABLES tableaddr*,
  MEMS memaddr*,
  TAGS tagaddr*,
  ELEMS elemaddr*,
  DATAS dataaddr*,
  EXPORTS exportinst*
}

syntax funcinst = {
  TYPE deftype,
  MODULE moduleinst,
  CODE funccode
}

syntax globalinst = {
  TYPE globaltype,
  VALUE value
}

syntax tableinst = {
  TYPE tabletype,
  REFS refval*
}

syntax meminst = {
  TYPE memtype,
  BYTES byte*
}

syntax taginst = {
  TYPE tagtype
}

syntax eleminst = {
  TYPE elemtype,
  REFS refval*
}

syntax datainst = {
  BYTES byte*
}

syntax fieldval =
  | FieldValue value
  | PackedField packtype nat

syntax structinst = {
  TYPE deftype,
  FIELDS fieldval*
}

syntax arrayinst = {
  TYPE deftype,
  FIELDS fieldval*
}

syntax exninst = {
  TAG tagaddr,
  FIELDS value*
}

;; Store and configurations

syntax store = {
  FUNCS funcinst*,
  GLOBALS globalinst*,
  TABLES tableinst*,
  MEMS meminst*,
  TAGS taginst*,
  ELEMS eleminst*,
  DATAS datainst*,
  STRUCTS structinst*,
  ARRAYS arrayinst*,
  EXNS exninst*
}

syntax frame = {
  LOCALS (value?)*,
  MODULE moduleinst
}

;; Administrative instructions and configurations.
;; These mirror eval.ml's admin_instr and config.  The OCaml code pair
;; (value stack, administrative instruction list) is flattened in Label,
;; Frame, Handler, and config so the P4-SpecTec store remains explicit.

syntax admininstr =
  | Plain instr
  | Refer refval
  | Invoke funcaddr
  | Breaking nat value*
  | Returning value*
  | ReturningInvoke value* funcaddr
  | Throwing tagaddr value*
  | Trapping
  | Label nat instr* value* admininstr*
  | Frame nat frame value* admininstr* ;; nat: the number of return values of the function
  | Handler nat catch* value* admininstr*

syntax config = (store, frame, value*, admininstr*)

syntax execoutcome =
  | ValuesO store value*
  | TrapO store
  | ExceptionO store tagaddr value*

syntax numresult =
  | NumValue num_
  | NumTrap

;; Meta variables

var a : addr
var fa : funcaddr
var ga : globaladdr
var ta : tableaddr
var ma : memaddr
var ja : tagaddr
var ea : elemaddr
var da : dataaddr
var xa : externaddr
var r : refval
var v : value
var adm : admininstr
var cf : config
var eo : execoutcome
var nr : numresult
var b : byte
var fpa : f32
var fpb : f32
var fpc : f32
var fda : f64
var fdb : f64
var fdc : f64
var STO : store
var fr : frame
var base : nat
var ni : nat
var nparam : nat
var nresult : nat
var nrest : nat
var nbytes : nat
var nsize : nat
var newsize : nat
var pages : nat
var offset : nat
var addrval : nat
var byteval : byte
var old : nat
var max : nat
var fail64 : i64
var src : nat
var k : nat
var dtf : deftype
var et : elemtype
var tactual : valtype
var rtactual : reftype
var fi : funcinst
var gi : globalinst
var tir : tableinst
var mir : meminst
var hir : taginst
var eir : eleminst
var dir : datainst
var fv : fieldval
var fvp : fieldval
var si : structinst
var ai : arrayinst
var xi : exportinst
var xir : exportinst

;; Constants and small list helpers

dec $page_size : nat
def $page_size = 65536


dec $empty_store : store
def $empty_store = {
  FUNCS eps,
  GLOBALS eps,
  TABLES eps,
  MEMS eps,
  TAGS eps,
  ELEMS eps,
  DATAS eps,
  STRUCTS eps,
  ARRAYS eps,
  EXNS eps
}

dec $empty_moduleinst : moduleinst
def $empty_moduleinst = {
  TYPES eps,
  FUNCS eps,
  GLOBALS eps,
  TABLES eps,
  MEMS eps,
  TAGS eps,
  ELEMS eps,
  DATAS eps,
  EXPORTS eps
}

dec $range_from(nat, nat) : nat*
def $range_from(_, n) = eps
  -- if n = 0
def $range_from(base, n) = base :: $range_from(base', n')
  -- if $(n > 0)
  -- if base' = $(base + 1)
  -- if n' = $(n - 1)

dec $limits_min_nat(limits) : nat
def $limits_min_nat({ MIN u64, MAX _ }) = u64

dec $nat_of_num(num_) : nat
def $nat_of_num(I32 n) = n
def $nat_of_num(I64 i) = n
  -- if n = $(i)

dec $addr_plus_offset(num_, int) : nat
def $addr_plus_offset(num, int_1) = addrval
  -- if base = $nat_of_num(num)
  -- if $(int_1 >= 0)
  -- if offset = $(int_1)
  -- if addrval = $(base + offset)

